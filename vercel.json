{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "michaeljlow.com" }],
      "destination": "https://www.workwithlayer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.michaeljlow.com" }],
      "destination": "https://www.workwithlayer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "workwithlayer.com" }],
      "destination": "https://www.workwithlayer.com/:path*",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/how-i-work",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/how-i-work/",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/how-it-works/",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/systems/invoiceflow-ap",
      "destination": "/insights/invoice-processing-automation",
      "permanent": true
    },
    {
      "source": "/systems/invoiceflow-ap/",
      "destination": "/insights/invoice-processing-automation",
      "permanent": true
    },
    {
      "source": "/insights/invoice-and-document-processing",
      "destination": "/insights/invoice-processing-automation",
      "permanent": true
    },
    {
      "source": "/insights/invoice-and-document-processing/",
      "destination": "/insights/invoice-processing-automation",
      "permanent": true
    },
    {
      "source": "/insights/opsdesk-shared-inbox-control",
      "destination": "/insights/shared-inbox-routing-and-approval",
      "permanent": true
    },
    {
      "source": "/insights/opsdesk-shared-inbox-control/",
      "destination": "/insights/shared-inbox-routing-and-approval",
      "permanent": true
    },
    {
      "source": "/insights/marketing-operations-workflow",
      "destination": "/insights/marketing-content-engine",
      "permanent": true
    },
    {
      "source": "/insights/marketing-operations-workflow/",
      "destination": "/insights/marketing-content-engine",
      "permanent": true
    },
    {
      "source": "/insights/lead-qualification-and-follow-up",
      "destination": "/insights/sales-opportunity-intelligence",
      "permanent": true
    },
    {
      "source": "/insights/lead-qualification-and-follow-up/",
      "destination": "/insights/sales-opportunity-intelligence",
      "permanent": true
    }
  ]
}

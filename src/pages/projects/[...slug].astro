---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import ContentClosing from '../../components/ContentClosing.astro';
import OutcomeList from '../../components/OutcomeList.astro';
import { pageTitle } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => !p.data.draft)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, outcomes } = project.data;
const isCaseStudy = project.data.featured;
---

<Layout
  title={project.slug === 'opsdesk-ai' ? 'OpsDesk | Shared Inbox Routing and Approval' : pageTitle(title)}
  description={description}
  ogImage={project.data.coverImage}
  noindex={project.data.noindex}
>
  <div class="project-case-study">
    <CaseStudyHero project={project} />
    <article class="project-case-study__article">
      <div class="project-case-study__body">
        {!isCaseStudy && outcomes.length > 0 && <OutcomeList outcomes={outcomes} />}
        <div class="project-case-study__content">
          <Content />
        </div>
      </div>
    </article>
    {
      project.data.closing && (
        <ContentClosing
          title={project.data.closing.title}
          body={project.data.closing.body}
          label={project.data.closing.label}
          href={project.data.closing.href}
        />
      )
    }
  </div>
</Layout>

<style>
  .project-case-study {
    background: var(--ml-paper);
    color: var(--ml-ink);
    max-width: 100%;
    overflow-x: clip;
  }

  .project-case-study__article {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .project-case-study__body {
    margin-inline: auto;
    max-width: 100%;
    min-width: 0;
    width: var(--ml-shell);
  }

  .project-case-study__content {
    color: var(--ml-ink-soft);
    max-width: 100%;
    min-width: 0;
  }

  .project-case-study__content :global(> h2),
  .project-case-study__content :global(> h3),
  .project-case-study__content :global(> p),
  .project-case-study__content :global(> ul),
  .project-case-study__content :global(> ol) {
    width: min(100%, 46rem);
    margin-inline: auto;
  }

  .project-case-study__content :global(> h2) {
    margin-top: clamp(4.5rem, 8vw, 8rem);
    margin-bottom: 1.25rem;
    color: var(--ml-ink);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.7rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .project-case-study__content :global(> h2:first-child) {
    margin-top: 0;
  }

  .project-case-study__content :global(> h3) {
    margin-top: 2.5rem;
    margin-bottom: 0.65rem;
    color: var(--ml-ink);
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .project-case-study__content :global(> p),
  .project-case-study__content :global(> li) {
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    font-weight: 300;
    line-height: 1.78;
  }

  .project-case-study__content :global(> p + p) {
    margin-top: 1rem;
  }

  .project-case-study__content :global(> ul),
  .project-case-study__content :global(> ol) {
    margin-top: 1.25rem;
    padding-left: 1.25rem;
  }

  .project-case-study__content :global(> ul li),
  .project-case-study__content :global(> ol li) {
    margin-top: 0.55rem;
    line-height: 1.65;
  }

  .project-case-study__content :global(a:not(.project-brief__cta-action)) {
    color: var(--ml-clay);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .project-case-study__content :global(strong) {
    color: var(--ml-ink);
    font-weight: 500;
  }

  .project-case-study__article:has(:global(.project-brief__cta-band)),
  .project-case-study:has(:global(.content-closing)) .project-case-study__article {
    padding-bottom: 0;
  }

  .project-case-study__article:has(:global(.project-brief__cta-band)) .project-case-study__body {
    padding-bottom: 0;
  }
</style>

---
const directions = [
  { id: 'editorial', number: '01', label: 'Asymmetric editorial' },
  { id: 'billboard', number: '02', label: 'Typographic billboard' },
  { id: 'corners', number: '03', label: 'Opposing corners' },
  { id: 'rail', number: '04', label: 'Structured bottom rail' },
  { id: 'centre', number: '05', label: 'Amplified centre' },
  { id: 'split', number: '06', label: 'Editorial split' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Hero Impact Lab | Layer</title>
  </head>
  <body>
    <nav class="lab-index" aria-label="Hero directions">
      {directions.map((direction) => (
        <a href={`#${direction.id}`}><span>{direction.number}</span>{direction.label}</a>
      ))}
    </nav>

    <main>
      {directions.map((direction) => (
        <section id={direction.id} class={`hero hero--${direction.id}`} aria-labelledby={`${direction.id}-title`}>
          <div class="hero__atmosphere" aria-hidden="true"></div>
          <header class="mock-nav">
            <a class="wordmark" href="#editorial" aria-label="Layer">layer<span>.</span></a>
            <nav aria-label={`${direction.label} preview navigation`}>
              <a href="#">What We Build</a>
              <a href="#">How It Works</a>
              <a href="#">About</a>
              <a href="#">Contact</a>
            </nav>
            <a class="nav-cta" href="#">Request AI Opportunity Audit <span>↗</span></a>
          </header>

          <div class="hero__frame">
            <div class="hero__statement">
              <p class="kicker">Built to run. Designed to be monitored.</p>
              <h2 id={`${direction.id}-title`}>
                <span>AI systems</span>
                <span>for growing businesses<span class="period">.</span></span>
              </h2>
            </div>

            <div class="hero__support">
              <p>We design, build and manage AI agents and automations around the tools your team already uses.</p>
              <div class="actions">
                <a class="button" href="#">Request AI Opportunity Audit <span>↗</span></a>
                <a class="text-link" href="#">See example systems <span>↓</span></a>
              </div>
            </div>

            <div class="legend" aria-hidden="true"><span>Team</span><i></i><strong>Layer</strong><i></i><span>Tools</span></div>
            <p class="direction-label"><span>{direction.number}</span>{direction.label}</p>
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: auto; }
  :global(body) {
    margin: 0;
    color: #f7f7f4;
    background: #0d1724;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  :global(a) { color: inherit; text-decoration: none; }

  .lab-index {
    position: fixed;
    z-index: 30;
    right: 1rem;
    top: 5.5rem;
    display: grid;
    gap: 0.35rem;
    width: 12.5rem;
    padding: 0.55rem;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: .35rem;
    background: rgba(7,17,29,.76);
    backdrop-filter: blur(18px);
    box-shadow: 0 20px 60px rgba(0,0,0,.25);
  }
  .lab-index a {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: .45rem;
    padding: .55rem .6rem;
    border-radius: .2rem;
    color: rgba(255,255,255,.7);
    font-size: .68rem;
    line-height: 1.25;
  }
  .lab-index a:hover { color: #fff; background: rgba(255,255,255,.08); }
  .lab-index span { color: #e4a078; font-family: 'IBM Plex Mono', monospace; }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    scroll-snap-align: start;
    background: #101b2b;
  }
  main { scroll-snap-type: y proximity; }
  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 70% 60% at 0 0, rgba(72,178,186,.58), transparent 62%),
      radial-gradient(ellipse 74% 66% at 100% 100%, rgba(224,122,48,.7), transparent 60%),
      #101b2b;
  }
  .hero__atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 46% at 6% 4%, rgba(90,196,198,.36), transparent 70%),
      radial-gradient(ellipse 56% 50% at 94% 96%, rgba(240,148,68,.4), transparent 68%);
    filter: blur(48px);
  }
  .hero__atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .5;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.9'/%3E%3C/svg%3E");
  }

  .mock-nav {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    right: 0;
    height: 4.75rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 2rem;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .wordmark { font-size: 1.45rem; font-weight: 500; letter-spacing: -.07em; }
  .wordmark span, .period { color: #6eb4e8; }
  .mock-nav nav { display: flex; gap: 2.1rem; color: rgba(255,255,255,.72); font-size: .82rem; }
  .nav-cta {
    justify-self: end;
    padding: .75rem 1rem;
    border: 1px solid rgba(255,255,255,.32);
    border-radius: .18rem;
    font-size: .78rem;
    font-weight: 500;
  }

  .hero__frame {
    position: relative;
    z-index: 2;
    width: min(94rem, calc(100% - 4rem));
    min-height: 100svh;
    margin: 0 auto;
    padding: 7rem 0 4.5rem;
  }
  .kicker, .direction-label, .legend {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .61rem;
  }
  .kicker { color: rgba(255,255,255,.55); }
  h2 {
    margin: 0;
    color: #fff;
    font-weight: 500;
    letter-spacing: -.06em;
    line-height: .95;
  }
  h2 > span { display: block; }
  .hero__support > p {
    margin: 0;
    color: rgba(244,245,247,.72);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-weight: 300;
    line-height: 1.65;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 1.5rem; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: 3.35rem;
    padding: .9rem 1.2rem;
    border-radius: .18rem;
    color: #10233e;
    background: #f8f6f1;
    font-size: .84rem;
    font-weight: 500;
  }
  .text-link { padding: .75rem 0; border-bottom: 1px solid rgba(255,255,255,.32); font-size: .84rem; }
  .legend {
    position: absolute;
    left: 0;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .65rem;
    color: rgba(255,255,255,.45);
    font-size: .52rem;
  }
  .legend i { width: 1.35rem; height: 1px; background: rgba(255,255,255,.3); }
  .legend strong { color: #fff; font-weight: 500; }
  .direction-label {
    position: absolute;
    right: 0;
    bottom: 1.25rem;
    margin: 0;
    color: rgba(255,255,255,.5);
  }
  .direction-label span { margin-right: .75rem; color: #e4a078; }

  /* 01 — Asymmetric editorial */
  .hero--editorial .hero__statement { position: absolute; left: 0; top: 24%; width: 76%; }
  .hero--editorial .kicker { margin: 0 0 2rem; }
  .hero--editorial h2 { font-size: clamp(4.5rem, 8vw, 8.5rem); }
  .hero--editorial h2 span:last-child { margin-left: 12%; }
  .hero--editorial .hero__support { position: absolute; right: 3%; bottom: 12%; width: min(31rem, 38%); }

  /* 02 — Typographic billboard */
  .hero--billboard .hero__statement { position: absolute; left: 0; right: 0; top: 25%; }
  .hero--billboard .kicker { margin: 0 0 1.5rem; }
  .hero--billboard h2 { font-size: clamp(5rem, 9.25vw, 9.8rem); max-width: 11ch; }
  .hero--billboard .hero__support {
    position: absolute;
    left: 0;
    right: 15%;
    bottom: 8%;
    display: grid;
    grid-template-columns: minmax(18rem, 32rem) 1fr;
    gap: 4rem;
    align-items: end;
  }
  .hero--billboard .actions { justify-content: flex-end; margin: 0; }

  /* 03 — Opposing corners */
  .hero--corners .hero__statement { position: absolute; inset: 0; }
  .hero--corners .kicker { position: absolute; left: 1%; top: 22%; margin: 0; }
  .hero--corners h2 { font-size: clamp(4.5rem, 8.2vw, 8.8rem); }
  .hero--corners h2 span:first-child { position: absolute; left: 0; top: 29%; }
  .hero--corners h2 span:last-child { position: absolute; right: 3%; bottom: 21%; text-align: right; }
  .hero--corners .hero__support { position: absolute; left: 34%; top: 47%; width: min(29rem, 34%); }

  /* 04 — Structured bottom rail */
  .hero--rail .hero__statement { position: absolute; left: 0; top: 25%; width: 78%; }
  .hero--rail .kicker { margin: 0 0 1.5rem; }
  .hero--rail h2 { font-size: clamp(4.8rem, 8.5vw, 9rem); }
  .hero--rail .hero__support {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4.4rem;
    display: grid;
    grid-template-columns: minmax(20rem, 35rem) auto;
    align-items: center;
    gap: 4rem;
    padding: 1.35rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,.2);
    border-bottom: 1px solid rgba(255,255,255,.2);
    background: rgba(8,21,35,.34);
    backdrop-filter: blur(12px);
  }
  .hero--rail .actions { justify-content: flex-end; margin: 0; }

  /* 05 — Amplified centre */
  .hero--centre .hero__statement {
    position: absolute;
    left: 50%;
    top: 31%;
    width: min(70rem, 90%);
    transform: translateX(-50%);
    text-align: center;
  }
  .hero--centre .kicker { margin: 0 0 1.75rem; }
  .hero--centre h2 { font-size: clamp(4.2rem, 7.3vw, 7.7rem); }
  .hero--centre .hero__support {
    position: absolute;
    left: 50%;
    top: 64%;
    width: min(39rem, 84%);
    transform: translateX(-50%);
    text-align: center;
  }
  .hero--centre .actions { justify-content: center; }

  /* 06 — Editorial split */
  .hero--split .hero__statement {
    position: absolute;
    left: 0;
    top: 30%;
    width: 54%;
  }
  .hero--split .kicker { margin: 0 0 1.75rem; }
  .hero--split h2 span:first-child {
    font-size: clamp(4.8rem, 7.6vw, 8rem);
    line-height: .82;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero--split h2 span:last-child {
    max-width: 11ch;
    margin-top: 1.15rem;
    font-size: clamp(2.5rem, 4vw, 4.25rem);
    line-height: 1;
    letter-spacing: -.055em;
  }
  .hero--split .hero__support {
    position: absolute;
    right: 4%;
    top: 43%;
    width: min(32rem, 36%);
  }
  .hero--split .hero__support > p {
    font-size: clamp(1.1rem, 1.55vw, 1.4rem);
  }
  .hero--split .actions {
    align-items: flex-start;
    flex-direction: column;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .lab-index { top: auto; left: 50%; right: auto; bottom: .75rem; width: min(94%, 38rem); grid-template-columns: repeat(6,1fr); transform: translateX(-50%); }
    .lab-index a { display: block; padding: .5rem; text-align: center; font-size: 0; }
    .lab-index span { font-size: .67rem; }
    .mock-nav { grid-template-columns: 1fr auto; padding: 0 1rem; }
    .mock-nav nav { display: none; }
    .nav-cta { font-size: .67rem; }
    .hero__frame { width: calc(100% - 2rem); }
    .hero--editorial .hero__statement,
    .hero--billboard .hero__statement,
    .hero--rail .hero__statement { top: 24%; width: 100%; }
    .hero--editorial h2 span:last-child { margin-left: 0; }
    .hero--editorial .hero__support,
    .hero--billboard .hero__support,
    .hero--corners .hero__support,
    .hero--rail .hero__support,
    .hero--centre .hero__support {
      left: 0; right: 0; top: auto; bottom: 9%; width: 100%; transform: none; display: block; padding: 0; background: transparent; border: 0; text-align: left;
    }
    .hero--corners .hero__statement { inset: auto; left: 0; right: 0; top: 24%; }
    .hero--corners .kicker, .hero--corners h2 span:first-child, .hero--corners h2 span:last-child { position: static; text-align: left; }
    .hero--corners .kicker { margin-bottom: 1.5rem; }
    h2 { font-size: clamp(3.2rem, 14vw, 5rem) !important; }
    .hero--centre .hero__statement,
    .hero--split .hero__statement { left: 0; top: 24%; width: 100%; transform: none; text-align: left; }
    .hero--split h2 span:first-child,
    .hero--split h2 span:last-child { font-size: clamp(3.2rem, 14vw, 5rem); line-height: .95; }
    .hero--split .hero__support { left: 0; right: 0; top: auto; bottom: 9%; width: 100%; }
    .actions, .hero--billboard .actions, .hero--rail .actions, .hero--centre .actions { justify-content: flex-start; margin-top: 1.25rem; }
    .legend, .direction-label { display: none; }
  }
</style>

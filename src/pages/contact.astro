---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, seo, contact, discoveryCall } from '../config/site';

const alternatives = [
  { label: 'Email directly', value: site.email, href: `mailto:${site.email}`, external: false },
  { label: 'LinkedIn', value: 'Connect on LinkedIn', href: site.linkedin, external: true },
];
---

<Layout
  title={seo.contact.title}
  description={seo.contact.description}
>
  <div class="inner-v2 contact-page">
    <PageHeader label={contact.kicker} title={contact.title} subtitle={contact.intro} />

    <section class="inner-v2-section">
      <div class="home-v2-shell contact-page__layout">
        <div class="contact-page__action">
          <ContactForm variant="page" />
          <p class="contact-page__helper">{contact.helper}</p>
        </div>

        <aside class="contact-page__aside">
          <div class="contact-page__panel">
            <p class="home-v2-kicker">What the audit includes</p>
            <ul class="contact-page__list">
              {discoveryCall.includes.map((item) => <li>{item}</li>)}
            </ul>
            <p class="contact-page__credit">
              {discoveryCall.duration}. A limited number are currently available at no cost to selected businesses.
            </p>
          </div>

          <div class="contact-page__panel contact-page__panel--quiet">
            <p class="home-v2-kicker">Other ways to reach us</p>
            <div class="contact-page__alts">
              {alternatives.map((link) => (
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <small>{link.label}</small>
                  <strong>{link.value}</strong>
                </a>
              ))}
            </div>
            <p class="contact-page__availability">
              <i aria-hidden="true"></i>{site.availability}
            </p>
          </div>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .contact-page__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.3rem;
    margin-top: 0.4rem;
    padding: 0.85rem 1.3rem;
    border-radius: 0.35rem;
    color: #fff;
    background: var(--ml-ink);
    border: 1px solid var(--ml-ink);
    font-size: 0.96rem;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-page__button:hover {
    background: #1a1f26;
  }

  .contact-page__button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .contact-page__helper,
  .contact-page__credit {
    margin: 1rem 0 0;
    color: var(--ml-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .contact-page__aside {
    display: grid;
    gap: 1rem;
  }

  .contact-page__panel {
    padding: 1.35rem;
    border: 1px solid var(--ml-line);
    border-radius: 0.5rem;
    background: var(--ml-paper-raised);
  }

  .contact-page__panel--quiet {
    background: var(--ml-paper);
  }

  .contact-page__list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .contact-page__list li {
    color: var(--ml-ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .contact-page__alts {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.85rem;
  }

  .contact-page__alts a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
  }

  .contact-page__alts small {
    color: var(--ml-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-page__alts strong {
    color: var(--ml-ink);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .contact-page__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    color: var(--ml-ink-soft);
    font-size: 0.88rem;
  }

  .contact-page__availability i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ml-success, #1f6b4a);
  }

  @media (max-width: 980px) {
    .contact-page__layout {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { seo } from '../../config/site';

const caseStudy = await getEntry('projects', 'instagram-enquiries-to-crm-ready-leads');
---

<Layout
  title={seo.insights.title}
  description={seo.insights.description}
>
  <main class="insights-page">
    <header class="insights-hero">
      <div class="insights-shell insights-hero__grid">
        <div>
          <p class="insights-kicker">Insights</p>
          <h1>Practical thinking for the work between systems.</h1>
        </div>
        <p>
          Case studies and clear explanations of how applied AI systems work, where automation creates value, and how
          to keep people in control.
        </p>
      </div>
    </header>

    <section class="insights-library" aria-labelledby="latest-insights">
      <div class="insights-shell">
        <div class="insights-library__head">
          <h2 id="latest-insights">Latest insights</h2>
          <p>Case studies, system explainers, workflow design notes and lessons from building practical AI.</p>
        </div>

        {
          caseStudy && !caseStudy.data.draft ? (
            <article class="case-study-card">
              <a class="case-study-card__image" href={`/projects/${caseStudy.slug}`}>
                <img
                  src={caseStudy.data.cardImage || caseStudy.data.coverImage || '/images/og-default.jpg'}
                  alt="Instagram property enquiry moving through Layer into a CRM-ready HubSpot lead"
                  width="1448"
                  height="1086"
                  loading="eager"
                  decoding="async"
                />
              </a>
              <div class="case-study-card__copy">
                <p class="insights-kicker">Case study · Real estate lead automation</p>
                <h3><a href={`/projects/${caseStudy.slug}`}>{caseStudy.data.title}</a></h3>
                <p>{caseStudy.data.description}</p>
                <a class="case-study-card__link" href={`/projects/${caseStudy.slug}`}>
                  Read case study <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ) : (
            <p>No insights have been published yet.</p>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .insights-page {
    --insights-ink: #12151a;
    --insights-soft: #505a66;
    --insights-muted: #737b85;
    --insights-navy: #1d3557;
    --insights-line: rgba(29, 53, 87, 0.14);
    color: var(--insights-ink);
    background: #f6f4ef;
  }

  .insights-shell {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
  }

  .insights-kicker {
    margin: 0;
    color: var(--insights-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insights-hero {
    padding-block: clamp(5rem, 10vw, 9rem);
    background:
      radial-gradient(circle at 83% 10%, rgba(203, 137, 112, 0.18), transparent 30%),
      linear-gradient(145deg, #f7f4ee, #e7ebeb);
  }

  .insights-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.52fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
  }

  .insights-hero h1 {
    max-width: 13ch;
    margin: 1.2rem 0 0;
    font-size: clamp(3.3rem, 7vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .insights-hero__grid > p {
    margin: 0;
    color: var(--insights-soft);
    font-size: 1.08rem;
    font-weight: 300;
    line-height: 1.75;
  }

  .insights-library {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .insights-library__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--insights-line);
  }

  .insights-library__head h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .insights-library__head p {
    max-width: 34rem;
    margin: 0;
    color: var(--insights-muted);
    font-size: 0.84rem;
    font-weight: 300;
    line-height: 1.55;
    text-align: right;
  }

  .case-study-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    margin-bottom: 1rem;
    overflow: hidden;
    border: 1px solid var(--insights-line);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 18px 48px rgba(29, 53, 87, 0.07);
  }

  .case-study-card__image {
    display: block;
    min-height: 25rem;
    overflow: hidden;
    background: #eef1ee;
  }

  .case-study-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study-card__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }

  .case-study-card h3 {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .case-study-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .case-study-card__copy > p:not(.insights-kicker) {
    margin: 1.35rem 0 0;
    color: var(--insights-soft);
    font-weight: 300;
    line-height: 1.7;
  }

  .case-study-card__link {
    align-self: start;
    margin-top: 2rem;
    color: var(--insights-navy);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .case-study-card__link span {
    margin-left: 0.4rem;
  }

  @media (max-width: 900px) {
    .insights-hero__grid,
    .case-study-card {
      grid-template-columns: 1fr;
    }

    .case-study-card__image {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 560px) {
    .insights-shell {
      width: min(100% - 2rem, 92rem);
    }

    .insights-library__head {
      display: grid;
    }

    .insights-library__head p {
      text-align: left;
    }
  }
</style>

---
import { getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { seo } from '../../config/site';
import { readingTime } from '../../utils/content';

const guide = await getEntry('insights', 'before-you-add-ai');
const caseStudy = await getEntry('projects', 'instagram-enquiries-to-crm-ready-leads');
const publishedGuide = guide && !guide.data.draft ? guide : null;
const publishedCaseStudy = caseStudy && !caseStudy.data.draft ? caseStudy : null;

const guideHref = publishedGuide ? `/insights/${publishedGuide.slug}` : '';
const caseHref = publishedCaseStudy ? `/projects/${publishedCaseStudy.slug}` : '';
const guideMeta = publishedGuide
  ? `${publishedGuide.data.series} · ${publishedGuide.data.topic} · ${readingTime(publishedGuide.body)}`
  : '';
const caseMeta = publishedCaseStudy
  ? `Case study · ${publishedCaseStudy.data.category} · ${publishedCaseStudy.data.status} · ${readingTime(publishedCaseStudy.body)}`
  : '';
---

<Layout
  title={seo.insights.title}
  description={seo.insights.description}
>
  <div class="insights-page">
    <header class="insights-masthead">
      <div class="insights-shell insights-masthead__grid">
        <div>
          <p class="insights-kicker">Insights</p>
          <h1>Practical thinking for the work between systems.</h1>
        </div>
        <p>
          Case studies and clear explanations of how applied AI systems work, where automation creates value, and how
          to keep people in control.
        </p>
      </div>
    </header>

    <section class="insights-index" aria-label="Published insights">
      <div class="insights-shell">
        {
          publishedGuide ? (
            <article class="insights-lead">
              <a class="insights-lead__image" href={guideHref}>
                <img
                  src="/images/insights/before-you-add-ai/visual-1.webp"
                  alt="Diagram of a request moving through reliable execution, intelligence and human judgment before a completed document"
                  width="1448"
                  height="1086"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </a>
              <div class="insights-lead__copy">
                <p class="insights-meta">{guideMeta}</p>
                <h2><a href={guideHref}>{publishedGuide.data.title}</a></h2>
                <p class="insights-standfirst">{publishedGuide.data.description}</p>
                <a class="insights-more" href={guideHref}>
                  Read guide <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ) : null
        }

        {
          publishedCaseStudy ? (
            <article class="insights-case">
              <p class="insights-case__label">Case study</p>
              <a class="insights-case__image" href={caseHref}>
                <img
                  src={publishedCaseStudy.data.cardImage || publishedCaseStudy.data.coverImage || '/images/og-default.jpg'}
                  alt="Instagram property enquiry moving through Layer into a CRM-ready HubSpot lead"
                  width="1448"
                  height="1086"
                  loading={publishedGuide ? 'lazy' : 'eager'}
                  decoding="async"
                />
              </a>
              <div class="insights-case__copy">
                <p class="insights-meta">{caseMeta}</p>
                <h2><a href={caseHref}>{publishedCaseStudy.data.title}</a></h2>
                <p class="insights-standfirst">{publishedCaseStudy.data.description}</p>
                <a class="insights-more" href={caseHref}>
                  Read case study <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ) : null
        }

        {
          !publishedGuide && !publishedCaseStudy ? (
            <p>No insights have been published yet.</p>
          ) : null
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .insights-page {
    --insights-ink: #12151a;
    --insights-soft: #505a66;
    --insights-muted: #737b85;
    --insights-navy: #1d3557;
    --insights-mist: #eef1ee;
    --insights-line: rgba(29, 53, 87, 0.14);
    color: var(--insights-ink);
    background: #f6f4ef;
  }

  .insights-shell {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
  }

  .insights-kicker,
  .insights-meta,
  .insights-case__label {
    margin: 0;
    color: var(--insights-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insights-masthead {
    padding-block: clamp(3rem, 4vw, 3.5rem);
  }

  .insights-masthead__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.42fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }

  .insights-masthead h1 {
    max-width: 15ch;
    margin: 0.7rem 0 0;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: clamp(2.5rem, 4.2vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    text-wrap: balance;
  }

  .insights-masthead__grid > p {
    margin: 0;
    max-width: 36rem;
    color: var(--insights-soft);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .insights-index {
    padding-block: clamp(2rem, 3vw, 3rem) clamp(4.5rem, 8vw, 6rem);
  }

  .insights-lead,
  .insights-case {
    border-top: 1px solid var(--insights-line);
  }

  .insights-lead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: center;
    padding-top: 2.25rem;
  }

  .insights-lead__image,
  .insights-case__image {
    display: grid;
    place-items: center;
    min-width: 0;
    overflow: hidden;
    border-radius: 0.55rem;
    background: #fff;
    text-decoration: none;
  }

  .insights-lead__image {
    height: clamp(16rem, 26vw, 24.375rem);
    background: #fff;
  }

  .insights-lead__image img,
  .insights-case__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .insights-lead__copy,
  .insights-case__copy {
    min-width: 0;
  }

  .insights-lead__copy .insights-meta {
    margin-bottom: 1rem;
  }

  .insights-lead h2,
  .insights-case h2 {
    margin: 0;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .insights-lead h2 {
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    line-height: 1.02;
  }

  .insights-lead h2 a,
  .insights-case h2 a {
    color: inherit;
    text-decoration: none;
  }

  .insights-standfirst {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: var(--insights-soft);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .insights-more {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 1.35rem;
    color: var(--insights-navy);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .insights-more span {
    margin-left: 0.4rem;
  }

  .insights-case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    margin-top: clamp(4rem, 5vw, 5rem);
    padding-top: 1.75rem;
  }

  .insights-case__label {
    display: none;
  }

  .insights-case__image {
    height: clamp(10.5rem, 16vw, 13.5rem);
    background: var(--insights-mist);
  }

  .insights-case h2 {
    margin-top: 1rem;
    font-size: clamp(1.55rem, 2.1vw, 2.2rem);
    line-height: 1.08;
  }

  .insights-lead a:focus-visible,
  .insights-case a:focus-visible {
    outline: 2px solid var(--insights-navy);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .insights-masthead__grid,
    .insights-lead,
    .insights-case {
      grid-template-columns: 1fr;
    }

    .insights-masthead__grid {
      align-items: start;
      gap: 1.25rem;
    }

    .insights-lead {
      padding-top: 1.75rem;
    }

    .insights-lead__image {
      height: auto;
      max-height: 14.5rem;
      aspect-ratio: 16 / 10;
    }

    .insights-case {
      margin-top: 3.5rem;
      padding-top: 1.25rem;
    }

    .insights-case__label {
      display: block;
      margin-bottom: 1rem;
    }

    .insights-case__image {
      height: auto;
      max-height: 11.5rem;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 560px) {
    .insights-shell {
      width: min(100% - 2rem, 92rem);
    }

    .insights-masthead {
      padding-block: 1.5rem 1.35rem;
    }

    .insights-masthead h1 {
      margin-top: 0.55rem;
    }

    .insights-masthead__grid > p {
      font-size: 1.05rem;
    }

    .insights-index {
      padding-top: 1.25rem;
    }

    .insights-lead h2 a,
    .insights-case h2 a,
    .insights-lead__image,
    .insights-case__image {
      display: block;
    }
  }
</style>

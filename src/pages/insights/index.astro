---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { seo } from '../../config/site';

const insights = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const caseStudy = await getEntry('projects', 'instagram-enquiries-to-crm-ready-leads');
const [featured, ...rest] = insights;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title={seo.insights.title}
  description={seo.insights.description}
>
  <main class="insights-page">
    <header class="insights-hero">
      <div class="insights-shell insights-hero__grid">
        <div>
          <p class="insights-kicker">Resources</p>
          <h1>Practical thinking for the work between systems.</h1>
        </div>
        <p>
          Case studies and clear explanations of how applied AI systems work, where automation creates value, and how
          to keep people in control.
        </p>
      </div>
    </header>

    <section class="insights-library" aria-labelledby="latest-resources">
      <div class="insights-shell">
        <div class="insights-library__head">
          <h2 id="latest-resources">Latest resources</h2>
          <p>Case studies, system explainers, workflow design notes and lessons from building practical AI.</p>
        </div>

        {
          caseStudy && !caseStudy.data.draft && (
            <article class="case-study-card">
              <a class="case-study-card__image" href={`/projects/${caseStudy.slug}`}>
                <img
                  src={caseStudy.data.cardImage || caseStudy.data.coverImage || '/images/og-default.jpg'}
                  alt="Instagram property enquiry moving through Layer into a CRM-ready HubSpot lead"
                  width="1448"
                  height="1086"
                  loading="eager"
                  decoding="async"
                />
              </a>
              <div class="case-study-card__copy">
                <p class="insights-kicker">Case study · Real estate lead automation</p>
                <h3><a href={`/projects/${caseStudy.slug}`}>{caseStudy.data.title}</a></h3>
                <p>{caseStudy.data.description}</p>
                <a class="case-study-card__link" href={`/projects/${caseStudy.slug}`}>
                  Read case study <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          )
        }

        {
          featured ? (
            <article class="insight-feature">
              <a class="insight-feature__image" href={`/insights/${featured.slug}`}>
                <img
                  src={featured.data.coverImage}
                  alt={featured.data.coverAlt}
                  width="1024"
                  height="800"
                  loading="eager"
                  decoding="async"
                />
              </a>
              <div class="insight-feature__copy">
                <p class="insights-kicker">
                  {featured.data.series}
                  {featured.data.seriesNumber && ` · ${String(featured.data.seriesNumber).padStart(2, '0')}`}
                </p>
                <h3><a href={`/insights/${featured.slug}`}>{featured.data.title}</a></h3>
                <p>{featured.data.description}</p>
                <div class="insight-feature__meta">
                  <span>{formatDate(featured.data.publishedAt)}</span>
                  <span>{featured.data.topic}</span>
                </div>
                <a class="insight-feature__link" href={`/insights/${featured.slug}`}>
                  Read article <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ) : (
            <p>No insights have been published yet.</p>
          )
        }

        {
          rest.length > 0 && (
            <div class="insight-grid">
              {rest.map((insight) => (
                <article>
                  <a class="insight-grid__image" href={`/insights/${insight.slug}`}>
                    <img
                      src={insight.data.coverImage}
                      alt={insight.data.coverAlt}
                      width="1024"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <p class="insights-kicker">{insight.data.series}</p>
                  <h3><a href={`/insights/${insight.slug}`}>{insight.data.title}</a></h3>
                  <p>{insight.data.description}</p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="insights-series" aria-labelledby="series-title">
      <div class="insights-shell insights-series__grid">
        <div>
          <p class="insights-kicker">Series</p>
          <h2 id="series-title">How it works</h2>
        </div>
        <p>
          Plain-English walkthroughs of real operational workflows: what arrives, what the system handles, where
          people stay in control, and how it connects to existing tools.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .insights-page {
    --insights-ink: #12151a;
    --insights-soft: #505a66;
    --insights-muted: #737b85;
    --insights-navy: #1d3557;
    --insights-line: rgba(29, 53, 87, 0.14);
    color: var(--insights-ink);
    background: #f6f4ef;
  }

  .insights-shell {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
  }

  .insights-kicker {
    margin: 0;
    color: var(--insights-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insights-hero {
    padding-block: clamp(5rem, 10vw, 9rem);
    background:
      radial-gradient(circle at 83% 10%, rgba(203, 137, 112, 0.18), transparent 30%),
      linear-gradient(145deg, #f7f4ee, #e7ebeb);
  }

  .insights-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.52fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
  }

  .insights-hero h1 {
    max-width: 13ch;
    margin: 1.2rem 0 0;
    font-size: clamp(3.3rem, 7vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .insights-hero__grid > p {
    margin: 0;
    color: var(--insights-soft);
    font-size: 1.08rem;
    font-weight: 300;
    line-height: 1.75;
  }

  .insights-library {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .insights-library__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--insights-line);
  }

  .insights-library__head h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .insights-library__head p {
    max-width: 34rem;
    margin: 0;
    color: var(--insights-muted);
    font-size: 0.84rem;
    font-weight: 300;
    line-height: 1.55;
    text-align: right;
  }

  .case-study-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    margin-bottom: 1rem;
    overflow: hidden;
    border: 1px solid var(--insights-line);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 18px 48px rgba(29, 53, 87, 0.07);
  }

  .case-study-card__image {
    display: block;
    min-height: 25rem;
    overflow: hidden;
    background: #eef1ee;
  }

  .case-study-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study-card__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }

  .case-study-card h3 {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .case-study-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .case-study-card__copy > p:not(.insights-kicker) {
    margin: 1.35rem 0 0;
    color: var(--insights-soft);
    font-weight: 300;
    line-height: 1.7;
  }

  .case-study-card__link {
    align-self: start;
    margin-top: 2rem;
    color: var(--insights-navy);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .case-study-card__link span {
    margin-left: 0.4rem;
  }

  .insight-feature {
    position: relative;
    isolation: isolate;
    min-height: 34rem;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--insights-line);
    background: #172b47;
    box-shadow: 0 22px 60px rgba(29, 53, 87, 0.08);
  }

  .insight-feature::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(8, 19, 33, 0.9) 0%, rgba(8, 19, 33, 0.64) 43%, rgba(8, 19, 33, 0.06) 78%),
      linear-gradient(0deg, rgba(8, 19, 33, 0.55), transparent 42%);
  }

  .insight-feature__image {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    overflow: hidden;
    background: #172b47;
  }

  .insight-feature__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .insight-feature:hover .insight-feature__image img {
    transform: scale(1.018);
  }

  .insight-feature__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(100%, 42rem);
    min-height: 34rem;
    padding: clamp(2rem, 5vw, 5rem);
    color: #f4f5f7;
  }

  .insight-feature h3 {
    margin: 1rem 0 0;
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .insight-feature .insights-kicker {
    color: rgba(255, 255, 255, 0.68);
  }

  .insight-feature h3 a,
  .insight-grid h3 a {
    color: inherit;
    text-decoration: none;
  }

  .insight-feature__copy > p:not(.insights-kicker) {
    margin: 1.4rem 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-weight: 300;
    line-height: 1.7;
  }

  .insight-feature__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin-top: 1.8rem;
    color: rgba(255, 255, 255, 0.58);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .insight-feature__link {
    align-self: start;
    margin-top: 2rem;
    color: #fff;
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .insight-feature__link span {
    margin-left: 0.4rem;
  }

  .insight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .insight-grid article {
    padding: 1rem;
    border: 1px solid var(--insights-line);
    background: #fff;
  }

  .insight-grid__image {
    display: block;
    margin: -1rem -1rem 1.4rem;
  }

  .insight-grid__image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .insight-grid h3 {
    margin: 0.8rem 0 0;
    font-size: 1.55rem;
    font-weight: 450;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .insight-grid article > p:not(.insights-kicker) {
    color: var(--insights-soft);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .insights-series {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    color: #f4f5f7;
    background:
      radial-gradient(circle at 8% 15%, rgba(190, 118, 91, 0.3), transparent 32%),
      #172b47;
  }

  .insights-series__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.55fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
  }

  .insights-series .insights-kicker {
    color: rgba(255, 255, 255, 0.58);
  }

  .insights-series h2 {
    margin: 1rem 0 0;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .insights-series__grid > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 300;
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .insights-hero__grid,
    .insights-series__grid,
    .case-study-card {
      grid-template-columns: 1fr;
    }

    .case-study-card__image {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .insight-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .insights-shell {
      width: min(100% - 2rem, 92rem);
    }

    .insights-library__head {
      display: grid;
    }

    .insights-library__head p {
      text-align: left;
    }
  }
</style>

---
import Layout from '../components/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import IntegrationMarquee from '../components/IntegrationMarquee.astro';
import { organizationJsonLd, site, websiteJsonLd } from '../config/site';

const steps = [
  {
    number: '01',
    tone: 'understand',
    title: 'Audit the opportunity',
    description:
      'We review how work moves through your business, identify where AI or automation could create credible value and recommend the strongest first workflow.',
    service: 'AI Opportunity Audit',
    output:
      'A clear opportunity map, a recommended starting point and an evidence-led next step.',
    outputLabel: 'You receive',
    details: {
      lead:
        'A structured review that turns a broad interest in AI into a clear view of where it could create useful, measurable change.',
      fit:
        'Important work is slower, more manual or less reliable than it should be, but the right starting point is not yet clear.',
      includes: [
        'A focused review of how work moves through the priority area',
        'The strongest opportunities, constraints and obvious risks',
        'A recommended first workflow and the value it should create',
        'A concise written summary with a practical next step',
      ],
      progression:
        'If there is a credible opportunity, Layer scopes an AI Workflow Build around the recommended starting point. The audit may also recommend a simpler process change, further investigation or no build.',
      boundary:
        'The audit is focused and bounded. It is not a whole-company transformation programme or a commitment to build. A limited number are currently available at no cost to selected businesses.',
    },
  },
  {
    number: '02',
    tone: 'build',
    title: 'Design, build & launch',
    description:
      'Layer designs the workflow, connects it to the tools your team already uses, builds in the right controls, tests it and launches it into real work.',
    service: 'AI Workflow Build',
    output: 'One controlled production workflow, stabilised and ready to operate.',
    outputLabel: 'You receive',
    details: {
      lead:
        'One scoped engagement from workflow design through production launch, focused on delivering a complete working outcome.',
      fit:
        'The audit has identified a worthwhile first workflow and there is enough clarity about the value, scope, ownership and permissions to build responsibly.',
      includes: [
        'Workflow design around the way the business actually operates',
        'Connections to the tools, data and knowledge the work depends on',
        'The right mix of automation, AI and human judgement',
        'Permissions, testing, audit trails, manual controls and visible failure handling',
        'Production launch, stabilisation, documentation and handover',
      ],
      progression:
        'After launch, the client can take ownership of the completed workflow or ask Layer to manage it and expand into further workflows where the evidence supports it.',
      boundary:
        'The build covers one agreed workflow. It does not include unlimited revisions, silent autonomy, guaranteed returns or an open-ended support commitment.',
    },
  },
];

const managementDetails = {
  number: '04',
  tone: 'improve',
  title: '04 — Optional ongoing service',
  service: 'AI Workflow Management',
  details: {
    lead:
      'An optional ongoing relationship for clients who want Layer to remain responsible for the operational health of the workflows we build.',
    fit:
      'A Layer-built workflow is stable in production and the business wants continued monitoring, maintenance and a measured path to further improvements.',
    includes: [
      'Monitoring agreed workflow runs, failures and integration health',
      'Investigation and recovery support when something stops working',
      'Maintenance as connected tools and processes change',
      'Regular review of performance, value, risks and controls',
      'Further workflow improvements scoped when evidence supports them',
    ],
    progression:
      'Layer starts by keeping the first workflow healthy. Further workflows are prioritised and added through separately agreed phases, allowing a broader connected system to grow around proven value.',
    boundary:
      'Management is separately scoped and does not imply 24/7 human coverage, guaranteed uptime, unlimited development or support for systems Layer has not built or formally accepted.',
  },
};

const systems = [
  {
    tone: 'ember',
    icon: 'inbox',
    title: 'Shared Inbox Routing & Approval',
    description:
      'Requests arriving by email are classified, matched with the right context and routed according to urgency and your business rules. Routine work keeps moving, while exceptions and sensitive actions are held for the right person to approve.',
    image: '/images/projects/opsdesk/opsdesk-dashboard-homepage.png',
    imageAlt: 'OpsDesk request queue with chargeable work awaiting approval',
    href: '/insights/shared-inbox-routing-and-approval',
    cta: 'See how it works',
  },
  {
    tone: 'mist',
    icon: 'sales',
    title: 'Sales opportunity intelligence',
    description:
      'New prospects are continuously researched, enriched and assessed against your ideal customer profile. The best opportunities flow into the CRM with useful context and tailored outreach ready for review.',
    image: '/images/projects/prospect-intelligence-system.png',
    imageAlt: 'Prospect intelligence workspace showing researched prospects, ICP fit and outreach ready for review',
    imageFit: 'contain',
    href: '/insights/sales-opportunity-intelligence',
    cta: 'See how it works',
  },
  {
    tone: 'rose',
    icon: 'marketing',
    title: 'Marketing content engine',
    description:
      'Calls, meetings and internal knowledge are continuously turned into content ideas and first drafts. Relevant material is organised, shaped for the right channels and moved towards publication, with your team reviewing what goes live.',
    image: '/images/projects/marketing-content-system.png',
    imageAlt: 'Marketing content workspace showing source material, draft content and publishing review',
    imageFit: 'contain',
    href: '/insights/marketing-content-engine',
    cta: 'See how it works',
  },
  {
    tone: 'violet',
    icon: 'invoice',
    title: 'Invoice processing automation',
    description:
      'Invoices that arrive by email are extracted, checked against your rules and prepared as a draft bill in Xero or the accounting software the business already uses. Payment stays held until finance approves them.',
    image: '/images/systems/invoiceflow-ap/control-centre.png',
    imageAlt:
      'InvoiceFlow AP invoice review workspace showing validation checks, approval routing, and a draft accounting preview.',
    imageFit: 'contain',
    href: '/insights/invoice-processing-automation',
    cta: 'See how it works',
  },
];

const valueMeasures = [
  {
    number: '01',
    title: 'Hard savings',
    description: 'Costs that genuinely disappear from the business—not just time saved on paper.',
  },
  {
    number: '02',
    title: 'Capacity released',
    description: 'Time and attention freed up for more valuable work.',
  },
  {
    number: '03',
    title: 'Cost avoidance',
    description: 'Future hiring, outsourcing, rework, penalties or tools the business may no longer need.',
  },
  {
    number: '04',
    title: 'Revenue and cash impact',
    description: 'Better conversion, throughput, retention, invoicing or collections.',
  },
  {
    number: '05',
    title: 'Risk and control improvement',
    description: 'Fewer errors, clearer accountability, stronger compliance and greater resilience.',
  },
  {
    number: '06',
    title: 'Service and experience improvement',
    description: 'Faster, more consistent and less frustrating experiences for customers and employees.',
  },
];

const faqs = [
  {
    question: 'What kinds of businesses do you work with?',
    answer: [
      'Layer works best with growing businesses where important work is spread across email, spreadsheets, documents and different software tools.',
      'The strongest fit is usually a business where repetitive admin, manual handoffs or disconnected information are starting to slow the team down.',
    ],
  },
  {
    question: 'Do we need to replace our existing software?',
    answer: [
      'Usually, no.',
      'Layer is designed to work around the tools your team already relies on. We connect the right systems, improve how information moves between them and only recommend replacing software where there is a clear reason to.',
    ],
  },
  {
    question: 'What do you automate, and what stays with our team?',
    answer: [
      'We automate the repetitive and predictable parts of a workflow first: moving information, checking rules, preparing work, routing requests and keeping systems updated.',
      'Where judgement, approval or accountability matters, the right person stays in control. The aim is not maximum automation. It is the right level of automation for the process.',
    ],
  },
  {
    question: 'How does a project begin?',
    answer: [
      'We normally start with an AI Opportunity Audit focused on an important business priority and the way work currently moves through it.',
      'The audit identifies the strongest opportunity, the obvious constraints and a practical next step. A limited number are currently available at no cost to selected businesses.',
    ],
  },
  {
    question: 'Can we start with just one workflow?',
    answer: [
      'Yes. That is usually the best way to start.',
      'We build one useful system around a clearly defined problem, prove it in practice and extend into other workflows only where it creates value. You do not need to commit to a large transformation upfront.',
    ],
  },
  {
    question: 'How do you handle security, access and sensitive actions?',
    answer: [
      'We design access around the minimum the system actually needs and keep important actions behind clear controls.',
      'Depending on the workflow, that can include restricted permissions, human approval, audit trails, exception handling and manual override. Security and control are considered as part of the system design, not added afterwards.',
    ],
  },
  {
    question: 'How long does a project take?',
    answer: [
      'It depends on the workflow, the systems involved and how much needs to be integrated.',
      'The AI Opportunity Audit gives us the evidence needed to provide a realistic view of scope, complexity and timing before you commit to a build.',
    ],
  },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: site.description,
  url: `${site.url}/`,
  email: site.email,
  image: new URL(site.logo, `${site.url}/`).href,
  serviceType: 'AI and automation systems for growing businesses',
  areaServed: 'Worldwide',
  founder: {
    '@type': 'Person',
    name: site.founder,
    url: `${site.url}/about/`,
    sameAs: [site.linkedin],
  },
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'AI Opportunity Audit',
        description: 'A structured review to identify the strongest opportunity for AI or automation and the right first workflow.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'AI Workflow Build',
        description: 'A scoped engagement covering workflow design, integration, controls, testing and production launch.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'AI Workflow Management',
        description: 'Optional ongoing monitoring, maintenance and evidence-led improvement for agreed workflows.',
      },
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.join(' '),
    },
  })),
  url: `${site.url}/#faq`,
};
---

<Layout title={site.title} description={site.description} jsonLd={[websiteJsonLd, organizationJsonLd, serviceJsonLd, faqJsonLd]}>
  <div class="layer-home">
    <section class="layer-hero" aria-labelledby="hero-title">
      <div class="layer-hero__atmosphere" aria-hidden="true"></div>
      <div class="layer-shell layer-hero__inner">
        <div class="layer-hero__copy" data-reveal data-hero-reveal>
          <h1 id="hero-title">
            <span class="layer-hero__line layer-hero__line--primary">AI systems</span>
            <span class="layer-hero__line">for growing businesses<span class="layer-hero__period">.</span></span>
          </h1>
          <p class="layer-hero__intro">
            We design, build and manage AI agents and automations around the tools your team already uses.
          </p>
          <div class="layer-actions">
            <a class="layer-button layer-button--light" href="#contact">
              Request AI Opportunity Audit <span aria-hidden="true">↗</span>
            </a>
            <a class="layer-link" href="#systems">See example systems <span aria-hidden="true">↓</span></a>
          </div>
          <p class="layer-hero__note">Built to run. Designed to be monitored.</p>
        </div>
      </div>
      <div class="layer-shell layer-hero__legend" aria-hidden="true">
        <span>Team</span><i></i><strong>Layer</strong><i></i><span>Tools</span>
      </div>
    </section>

    <section id="how-we-work" class="layer-section layer-process" aria-labelledby="process-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-process__head" data-reveal>
          <div>
            <p class="layer-kicker">How Layer works</p>
            <h2 id="process-title">From opportunity to operation.</h2>
          </div>
          <p>
            A clear route from identifying the right opportunity to launching a working AI system—and deciding who
            manages it next.
          </p>
        </header>
        <ol class="layer-offer-steps" data-reveal-stagger>
          {steps.map((step) => (
            <Fragment>
              <li
                class={`layer-offer-card layer-offer-card--${step.tone}`}
                data-number={step.number}
                style={`--offer-image-position: ${step.number === '01' ? '0% 0%' : '100% 0%'}`}
                data-reveal
              >
                <div class="layer-step__atmosphere" aria-hidden="true">
                  <div class="layer-step__glow"></div>
                </div>
                <div class="layer-offer-card__copy">
                  <div class="layer-step__marker">
                    <span class="layer-step__badge">Step {step.number}</span>
                    <p class="layer-step__phase">{step.title}</p>
                  </div>
                  <h3>{step.service}</h3>
                  <p>{step.description}</p>
                  <div class="layer-offer-card__actions">
                    <button
                      class="layer-step__more"
                      type="button"
                      data-service-dialog-open={`service-dialog-${step.tone}`}
                      aria-haspopup="dialog"
                      aria-controls={`service-dialog-${step.tone}`}
                    >
                      More about this service <span aria-hidden="true">→</span>
                    </button>
                    {step.number === '01' && (
                      <a class="layer-button layer-button--primary layer-offer-card__cta" href="#contact">
                        Request AI Opportunity Audit <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
                <div class="layer-step__output">
                  <span>{step.outputLabel || 'Result'}</span>
                  <p>{step.output}</p>
                </div>
              </li>
              {step.number === '01' && (
                <li class="layer-offer-sequence-link" aria-hidden="true">
                  <span></span>
                  <em>Then</em>
                  <span></span>
                </li>
              )}
            </Fragment>
          ))}
          <li class="layer-offer-branch" aria-label="After launch, choose how the system is managed">
            <span class="layer-offer-branch__line" aria-hidden="true"></span>
            <p class="layer-kicker">After launch</p>
            <h3>Choose how the system is run.</h3>
            <p>Take ownership as a completed one-off build, or keep Layer involved to monitor and improve it.</p>
          </li>
          <li
            class="layer-offer-card layer-offer-card--handover"
            data-number="03"
            style="--offer-image-position: 0% 100%"
            data-reveal
          >
            <div class="layer-step__atmosphere" aria-hidden="true">
              <div class="layer-step__glow"></div>
            </div>
            <div class="layer-offer-card__copy">
              <p class="layer-step__phase">03 — One-off path</p>
              <h3>Handover to your team</h3>
              <p>
                Once the workflow is stable, we document it, train the right people and hand it over. No ongoing retainer
                is required.
              </p>
            </div>
            <div class="layer-step__output">
              <span>Complete outcome</span>
              <p>A bounded production workflow your team can own.</p>
            </div>
          </li>

          <li
            class="layer-offer-card layer-offer-card--managed"
            data-number="04"
            style="--offer-image-position: 100% 100%"
            data-reveal
          >
            <div class="layer-step__atmosphere" aria-hidden="true">
              <div class="layer-step__glow"></div>
            </div>
            <div class="layer-offer-card__copy">
              <p class="layer-step__phase">04 — Optional ongoing path</p>
              <h3>Managed by Layer</h3>
              <p>
                We monitor operational health, investigate failures, maintain the agreed workflow and improve it as your
                tools and processes change.
              </p>
              <div class="layer-offer-card__actions">
                <button
                  class="layer-step__more"
                  type="button"
                  data-service-dialog-open="service-dialog-improve"
                  aria-haspopup="dialog"
                  aria-controls="service-dialog-improve"
                >
                  More about ongoing management <span aria-hidden="true">→</span>
                </button>
                <a class="layer-button layer-button--light layer-offer-card__cta" href="#contact">
                  Request AI Opportunity Audit <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
            <div class="layer-step__output">
              <span>Build from there</span>
              <p>Further workflows are scoped and added only when the evidence supports them.</p>
            </div>
          </li>

          <li class="layer-integrations" data-reveal>
            <div class="layer-integrations__copy">
              <div>
                <p class="layer-kicker">Works with your stack</p>
                <h3>Built around the tools your team already uses.</h3>
              </div>
              <div class="layer-integrations__detail">
                <p>
                  Layer connects the systems already running your business, including email, CRM, finance, documents
                  and internal tools, so useful work can move between them without forcing a platform change.
                </p>
                <p class="layer-integrations__note">And the tools specific to your business.</p>
              </div>
            </div>
            <div class="layer-integrations__logos">
              <IntegrationMarquee />
            </div>
          </li>
        </ol>

        {[...steps, managementDetails].map((step) => (
          <dialog
            id={`service-dialog-${step.tone}`}
            class="layer-service-dialog"
            data-service-dialog
            aria-labelledby={`service-dialog-title-${step.tone}`}
          >
            <div class="layer-service-dialog__panel">
              <header class="layer-service-dialog__header">
                <p>{step.title}</p>
                <form method="dialog">
                  <button type="submit" aria-label={`Close ${step.service} details`}>
                    <span aria-hidden="true">×</span>
                  </button>
                </form>
              </header>
              <div class="layer-service-dialog__body">
                <p class="layer-kicker">Service details</p>
                <h2 id={`service-dialog-title-${step.tone}`}>{step.service}</h2>
                <p class="layer-service-dialog__lead">{step.details.lead}</p>

                <section>
                  <h3>When it fits</h3>
                  <p>{step.details.fit}</p>
                </section>

                <section>
                  <h3>What you get</h3>
                  <ul>
                    {step.details.includes.map((item) => <li>{item}</li>)}
                  </ul>
                </section>

                <section>
                  <h3>How it progresses</h3>
                  <p>{step.details.progression}</p>
                </section>

                <aside class="layer-service-dialog__boundary">
                  <span>Clear boundary</span>
                  <p>{step.details.boundary}</p>
                </aside>

                <a class="layer-service-dialog__cta" href="#contact" data-dialog-contact>
                  Start a conversation <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </dialog>
        ))}
      </div>
    </section>

    <section id="systems" class="layer-section layer-systems" aria-labelledby="systems-title">
      <div class="layer-systems__scroller" data-systems-scroll>
        <div class="layer-systems__sticky">
          <div class="layer-shell">
            <header class="layer-section-head layer-systems__head" data-reveal>
              <div>
                <p class="layer-kicker">Example systems</p>
                <h2 id="systems-title">Systems Layer can build</h2>
              </div>
              <p>Every system is shaped around the teams, tools and software already inside the business.</p>
            </header>
            <div class="layer-system-viewport">
              <div class="layer-system-track" data-systems-track>
          {systems.map((system) => (
            <article class={`layer-system-card layer-system-card--${system.tone}`}>
              <div class="layer-system-card__copy">
                <span class="layer-system-card__icon" aria-hidden="true">
                  {system.icon === 'inbox' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 6.8v11.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                      <path d="M11.8 14.2 16 18.2 20.2 14.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M6.5 15.2h4.4l2 3.6h6.2l2-3.6h4.4V24.2H6.5V15.2Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                    </svg>
                  )}
                  {system.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <circle cx="16" cy="16" r="8.4" stroke="currentColor" stroke-width="1.45" />
                      <circle cx="16" cy="16" r="3.6" stroke="currentColor" stroke-width="1.45" />
                      <path d="M16 5.6v2.8M16 23.6v2.8M5.6 16h2.8M23.6 16h2.8" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                  {system.icon === 'marketing' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <rect x="8.5" y="6.8" width="15" height="18.4" rx="1.8" stroke="currentColor" stroke-width="1.45" />
                      <path d="M12.2 12.2h7.6M12.2 16h7.6M12.2 19.8h5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                  {system.icon === 'invoice' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M9.2 6.8h10.2L22.8 10.2V25.2H9.2V6.8Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                      <path d="M19.4 6.8v3.6h3.4" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                      <path d="M12.4 14.6h7.2M12.4 18.2h7.2M12.4 21.8h4.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <h3>{system.title}</h3>
                <p>{system.description}</p>
                {system.href ? (
                  <a class="layer-system-card__link" href={system.href}>
                    {system.cta} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="layer-system-card__soon">Case study coming soon</span>
                )}
              </div>
              <div class="layer-system-card__stage">
                <div class="layer-system-card__wash" aria-hidden="true"></div>
                {system.image ? (
                  <div class="layer-system-card__media">
                    <figure
                      class:list={[
                        'layer-system-card__shot',
                        system.imageFit === 'contain' && 'layer-system-card__shot--contain',
                      ]}
                    >
                      {system.href ? (
                        <a href={system.href} aria-label={`${system.cta}: ${system.title}`}>
                          <img
                            src={system.image}
                            alt={system.imageAlt || ''}
                            width="1024"
                            height="792"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <img
                          src={system.image}
                          alt={system.imageAlt || ''}
                          width="1024"
                          height="792"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </figure>
                  </div>
                ) : (
                  <div class="layer-system-card__placeholder">
                    <span>Screenshot coming soon</span>
                  </div>
                )}
              </div>
            </article>
          ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="value" class="layer-section layer-value" aria-labelledby="value-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-value__head" data-reveal>
          <div>
            <p class="layer-kicker">How Layer measures value</p>
            <h2 id="value-title">Six ways better work can create value.</h2>
          </div>
          <p>
            We measure the change that matters to the business—not AI activity for its own sake. The right measure
            depends on the workflow and the outcome you are trying to improve.
          </p>
        </header>
        <ol class="layer-value__grid" data-reveal-stagger>
          {valueMeasures.map((measure) => (
            <li data-reveal>
              <span class="layer-value__number">{measure.number}</span>
              <div>
                <h3>{measure.title}</h3>
                <p>{measure.description}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="layer-value__evidence" data-reveal>
          <p class="layer-kicker">Evidence before claims</p>
          <p>
            Every value case separates what is known, what is estimated and what is still unknown. Released capacity
            matters, but we only call it a cash saving when spend genuinely disappears.
          </p>
        </aside>
      </div>
    </section>

    <section id="faq" class="layer-section layer-faq" aria-labelledby="faq-title">
      <div class="layer-shell layer-faq__layout">
        <header class="layer-section-head" data-reveal>
          <p class="layer-kicker">Questions, answered</p>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p>Clear answers about how Layer works, what we build and how a project begins.</p>
        </header>
        <div class="layer-faq__list" data-faq data-reveal>
          {faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="layer-faq__answer">
                {item.answer.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="layer-contact" aria-labelledby="contact-title">
      <div class="layer-contact__atmosphere" aria-hidden="true"></div>
      <div class="layer-shell layer-contact__layout">
        <div class="layer-contact__copy" data-reveal>
          <p class="layer-kicker">Start a conversation</p>
          <h2 id="contact-title">Where is work getting stuck in your business?</h2>
          <p>
            Tell us where work is getting stuck. We’ll use the AI Opportunity Audit to identify the strongest starting
            point, the value it could create and the right next step.
          </p>
          <p class="layer-contact__note">Limited no-cost AI Opportunity Audits available to selected businesses.</p>
        </div>
        <div data-reveal>
          <ContactForm variant="home" />
        </div>
      </div>
    </section>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.querySelectorAll<HTMLElement>('[data-hero-reveal]').forEach((item) => item.classList.add('is-visible'));
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
      );
      revealItems.forEach((item) => {
        if (!item.hasAttribute('data-hero-reveal')) revealObserver.observe(item);
      });
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((detail) => {
      detail.addEventListener('toggle', () => {
        if (!detail.open) return;
        document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((other) => {
          if (other !== detail) other.open = false;
        });
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-service-dialog-open]').forEach((button) => {
      const dialogId = button.dataset.serviceDialogOpen;
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
      if (!dialog) return;

      button.addEventListener('click', () => {
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('.layer-service-dialog__header button')?.focus();
      });
      dialog.addEventListener('close', () => button.focus());
    });

    document.querySelectorAll<HTMLDialogElement>('[data-service-dialog]').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        const bounds = dialog.getBoundingClientRect();
        const outside =
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom;
        if (outside) dialog.close();
      });

      dialog.querySelectorAll<HTMLElement>('[data-dialog-contact]').forEach((link) => {
        link.addEventListener('click', () => dialog.close());
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openDialog = document.querySelector<HTMLDialogElement>('[data-service-dialog][open]');
      if (!openDialog) return;
      event.preventDefault();
      openDialog.close();
    });

    const systemsScroller = document.querySelector<HTMLElement>('[data-systems-scroll]');
    const systemsTrack = document.querySelector<HTMLElement>('[data-systems-track]');
    const systemsSticky = systemsScroller?.querySelector<HTMLElement>('.layer-systems__sticky');
    const desktopSystems = window.matchMedia('(min-width: 821px)');

    if (systemsScroller && systemsTrack && systemsSticky) {
      const viewport = systemsTrack.parentElement as HTMLElement;
      let ticking = false;

      const canPin = () => !reducedMotion && desktopSystems.matches;

      const updateSystems = () => {
        ticking = false;
        if (!canPin()) return;
        const pin = parseFloat(getComputedStyle(systemsSticky).top) || 0;
        const rect = systemsScroller.getBoundingClientRect();
        const range = Math.max(1, systemsScroller.offsetHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, (pin - rect.top) / range));
        const maxX = Math.max(0, systemsTrack.scrollWidth - viewport.clientWidth);
        systemsTrack.style.transform = `translate3d(${-maxX * progress}px, 0, 0)`;
      };

      const layoutSystems = () => {
        viewport.style.setProperty('--systems-w', `${viewport.clientWidth}px`);
        if (!canPin()) {
          systemsScroller.style.height = '';
          systemsTrack.style.transform = '';
          return;
        }
        const maxX = Math.max(0, systemsTrack.scrollWidth - viewport.clientWidth);
        systemsScroller.style.height = `${window.innerHeight + maxX * 1.15}px`;
        updateSystems();
      };

      const onSystemsScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateSystems);
      };

      layoutSystems();
      requestAnimationFrame(layoutSystems);
      window.addEventListener('scroll', onSystemsScroll, { passive: true });
      window.addEventListener('resize', layoutSystems);
      window.addEventListener('load', layoutSystems);
      desktopSystems.addEventListener('change', layoutSystems);
      if ('ResizeObserver' in window) {
        new ResizeObserver(layoutSystems).observe(viewport);
      }
    }
  </script>
</Layout>


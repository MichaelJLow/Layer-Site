---
import Layout from '../../components/Layout.astro';
import BuildCard from '../../components/builds/BuildCard.astro';
import { getPublishedBuilds } from '../../utils/content';
import { seo } from '../../config/site';

const builds = await getPublishedBuilds();
---

<Layout
  title={seo.builds.title}
  description={seo.builds.description}
  robots="noindex, follow"
>
  <div class="builds-page">
    <header class="builds-hero">
      <div class="builds-shell builds-hero__grid">
        <div>
          <p class="builds-kicker">Selected Builds</p>
          <h1>Systems I’ve designed, built and operated through Layer.</h1>
        </div>
        <p>
          A separate record of technical work. This surface is not part of the commercial site journey
          and is reached by direct URL only.
        </p>
      </div>
    </header>

    <section class="builds-library" aria-labelledby="builds-list">
      <div class="builds-shell">
        <div class="builds-library__head">
          <h2 id="builds-list">Builds</h2>
          <p>Technical write-ups of systems designed, built and operated in production. Reached by direct URL only.</p>
        </div>

        {
          builds.length > 0 ? (
            <div class="builds-list">
              {builds.map((build) => (
                <BuildCard build={build} />
              ))}
            </div>
          ) : (
            <p class="builds-empty">No builds have been published yet.</p>
          )
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .builds-page {
    --builds-ink: #12151a;
    --builds-navy: #1d3557;
    --builds-muted: #5c6570;
    --builds-soft: #505a66;
    --builds-line: rgba(29, 53, 87, 0.14);
    color: var(--builds-ink);
    background: #f6f4ef;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    max-width: 100%;
    overflow-x: clip;
  }

  .builds-shell {
    width: min(92rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .builds-kicker {
    margin: 0;
    color: var(--builds-navy);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .builds-hero {
    padding-block: clamp(2rem, 3.2vw, 2.75rem);
    background:
      radial-gradient(ellipse 42% 55% at 8% 12%, rgba(224, 160, 122, 0.28), transparent 62%),
      radial-gradient(ellipse 38% 48% at 92% 8%, rgba(122, 158, 196, 0.22), transparent 58%),
      linear-gradient(145deg, #f7f4ee, #e7ebeb);
  }

  .builds-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
  }

  .builds-hero h1 {
    max-width: 24ch;
    margin: 0.45rem 0 0;
    font-size: clamp(1.55rem, 2.4vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .builds-hero__grid > p {
    margin: 0;
    color: var(--builds-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.16rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .builds-library {
    padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(4.5rem, 8vw, 7.5rem);
  }

  .builds-library__head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(1.35rem, 2.4vw, 2rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--builds-line);
  }

  .builds-library__head h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }

  .builds-library__head p {
    max-width: 34rem;
    margin: 0;
    color: var(--builds-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.55;
    text-align: right;
  }

  .builds-list {
    display: grid;
    gap: 1rem;
  }

  .builds-empty {
    margin: 0;
    color: var(--builds-muted);
    font-weight: 300;
  }

  @media (max-width: 980px) {
    .builds-shell {
      width: min(100% - 2rem, 46rem);
    }

    .builds-hero__grid,
    .builds-library__head {
      grid-template-columns: minmax(0, 1fr);
      display: grid;
    }

    .builds-hero h1 {
      max-width: none;
    }

    .builds-library__head p {
      text-align: left;
    }
  }
</style>

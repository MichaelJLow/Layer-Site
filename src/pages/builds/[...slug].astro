---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import BuildHero from '../../components/builds/BuildHero.astro';
import { pageTitle } from '../../config/site';

export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds
    .filter((build) => !build.data.draft)
    .map((build) => ({
      params: { slug: build.slug },
      props: { build },
    }));
}

const { build } = Astro.props;
const { Content } = await render(build);
const { title, description } = build.data;
---

<Layout
  title={pageTitle(title)}
  description={description}
  ogImage={build.data.coverImage}
  robots="noindex, follow"
>
  <div class="build-page">
    <BuildHero build={build} />
    <article class="build-page__article">
      <div class="build-page__body">
        <div class="build-page__content">
          <Content />
        </div>
        <p class="build-page__back">
          <a href="/builds">
            <span aria-hidden="true">←</span>
            Back to all selected builds
          </a>
        </p>
      </div>
    </article>
  </div>
</Layout>

<style>
  .build-page {
    --builds-ink: #12151a;
    --builds-navy: #1d3557;
    --builds-muted: #5c6570;
    --builds-soft: #505a66;
    --builds-line: rgba(29, 53, 87, 0.14);
    --builds-shell: min(76rem, calc(100% - 3rem));
    --builds-copy: 43rem;
    background: #f6f4ef;
    color: var(--builds-ink);
    max-width: 100%;
    overflow-x: clip;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .build-page__article {
    padding-block: clamp(4rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }

  .build-page__body {
    width: var(--builds-shell);
    margin-inline: auto;
    max-width: 100%;
    min-width: 0;
  }

  .build-page__content {
    color: var(--builds-soft);
    max-width: 100%;
    min-width: 0;
  }

  .build-page__content :global(> h2),
  .build-page__content :global(> h3),
  .build-page__content :global(> p),
  .build-page__content :global(> ul),
  .build-page__content :global(> ol),
  .build-page__content :global(> figure),
  .build-page__content :global(> pre),
  .build-page__content :global(> blockquote),
  .build-page__content :global(> .build-callout) {
    width: min(100%, var(--builds-copy));
    margin-inline: 0 auto;
  }

  .build-page__content :global(> figure.build-visual--wide) {
    width: min(100%, 60rem);
  }

  .build-page__content :global(> .build-ops) {
    width: 100%;
    margin-inline: 0;
  }

  .build-page__content :global(> h2) {
    margin-top: clamp(4.25rem, 7vw, 6.5rem);
    margin-bottom: 1.15rem;
    color: var(--builds-ink);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .build-page__content :global(> h2:first-child) {
    margin-top: 0;
  }

  .build-page__content :global(> h2#outcome) {
    margin-top: clamp(4.5rem, 8vw, 7rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--builds-line);
  }

  .build-page__content :global(> h3) {
    margin-top: 2.25rem;
    margin-bottom: 0.65rem;
    color: var(--builds-ink);
    font-size: 1.08rem;
    font-weight: 500;
  }

  .build-page__content :global(> p),
  .build-page__content :global(> li) {
    font-size: clamp(1rem, 1.2vw, 1.075rem);
    font-weight: 300;
    line-height: 1.72;
  }

  .build-page__content :global(> p + p) {
    margin-top: 0.9rem;
  }

  .build-page__content :global(> ul),
  .build-page__content :global(> ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }

  .build-page__content :global(> ul li),
  .build-page__content :global(> ol li) {
    margin-top: 0.55rem;
    line-height: 1.65;
  }

  .build-page__content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--builds-line);
    border-radius: 0.55rem;
    background: #fff;
  }

  .build-page__content :global(a) {
    color: var(--builds-navy);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .build-page__content :global(strong) {
    color: var(--builds-ink);
    font-weight: 500;
  }

  .build-page__back {
    width: min(100%, var(--builds-copy));
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--builds-line);
  }

  .build-page__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    color: #fff;
    background: var(--builds-navy);
    border: 1px solid var(--builds-navy);
    border-radius: 0.35rem;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .build-page__back a:hover {
    transform: translateY(-1px);
    box-shadow: 0 9px 20px rgba(29, 53, 87, 0.18);
  }

  @media (max-width: 560px) {
    .build-page {
      --builds-shell: min(100% - 2rem, 76rem);
    }

    .build-page__body {
      width: var(--builds-shell);
    }

    .build-page__content :global(> h2) {
      margin-top: 4rem;
    }
  }
</style>

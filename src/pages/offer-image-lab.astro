---
import Layout from '../components/Layout.astro';

const directions = [
  {
    name: 'Direction A — Scientific imaging',
    note: 'Material structures, optical detail and controlled physical phenomena.',
    image: '/images/offer-concepts/scientific-imaging-board.png',
  },
  {
    name: 'Direction B — Motion recorded photographically',
    note: 'Long exposure, suspended particles and movement settling into rhythm.',
    image: '/images/offer-concepts/motion-photography-board.png',
  },
] as const;

const treatments = [
  {
    id: 'ink',
    label: 'B1 — Ink on paper',
    note: 'A restrained editorial system: three warm paper cards distinguished through image tint, then a decisive dark managed card.',
  },
  {
    id: 'tonal',
    label: 'B2 — Tonal progression',
    note: 'One colour family moving from ivory through silver and slate into midnight. The clearest sense of progression.',
  },
  {
    id: 'mineral',
    label: 'B3 — Muted mineral colours',
    note: 'Sandstone, mineral blue, oxidised bronze and petrol navy. More distinctive, tactile and deliberately varied.',
  },
] as const;

const tonalVariants = [
  { id: 'tonal', label: 'Current B2', note: 'Ivory · silver · slate · midnight' },
  { id: 'tonal-refined', label: 'Refined B2', note: 'Parchment · mineral grey-blue · blue slate · ink navy' },
] as const;

const cards = [
  {
    number: '01',
    tone: 'audit',
    eyebrow: 'Audit the opportunity',
    title: 'AI Opportunity Audit',
    body: 'We review how work moves through your business, identify where AI or automation could create credible value and recommend the strongest first workflow.',
    outputLabel: 'You receive',
    output: 'A clear opportunity map, a recommended starting point and an evidence-led next step.',
    position: '0% 0%',
  },
  {
    number: '02',
    tone: 'build',
    eyebrow: 'Design, build & launch',
    title: 'AI Workflow Build',
    body: 'Layer designs the workflow, connects it to the tools your team already uses, builds in the right controls, tests it and launches it into real work.',
    outputLabel: 'You receive',
    output: 'One controlled production workflow, stabilised and ready to operate.',
    position: '100% 0%',
  },
  {
    number: '03',
    tone: 'handover',
    eyebrow: 'One-off delivery',
    title: 'Handover to your team',
    body: 'Once the workflow is stable, we document it, train the right people and hand it over. No ongoing retainer is required.',
    outputLabel: 'Complete outcome',
    output: 'A bounded production workflow your team can own.',
    position: '0% 100%',
  },
  {
    number: '04',
    tone: 'managed',
    eyebrow: 'AI workflow management',
    title: 'Managed by Layer',
    body: 'We monitor operational health, investigate failures, maintain the agreed workflow and improve it as your tools and processes change.',
    outputLabel: 'Build from there',
    output: 'Further workflows are scoped and added only when the evidence supports them.',
    position: '100% 100%',
  },
] as const;
---

<Layout
  title="Offer Image Direction Lab | Layer"
  description="Internal comparison of generated image directions for the Layer offer section."
  noindex
>
  <main class="offer-lab">
    <header class="offer-lab__intro">
      <a href="/#how-we-work">← Back to the live section</a>
      <p class="offer-lab__kicker">Internal visual prototype</p>
      <h1>Offer-card image directions</h1>
      <p class="offer-lab__lede">
        Compare three colour systems using the same scientific image family, crop, dimming and real Layer copy.
        Only the colour logic changes.
      </p>
      <nav class="offer-lab__nav" aria-label="Colour treatment prototypes">
        <a href="#tonal-comparison">B2 refinement — A/B</a>
        {treatments.map((treatment) => <a href={`#${treatment.id}`}>{treatment.label}</a>)}
      </nav>
    </header>

    <section
      id="tonal-comparison"
      class="offer-lab__direction offer-lab__treatment"
      style="--board-image: url('/images/offer-concepts/scientific-imaging-board.png')"
    >
      <div class="offer-lab__direction-heading">
        <div>
          <p class="offer-lab__kicker">Controlled A/B comparison</p>
          <h2>B2 — Current vs refined</h2>
        </div>
        <p>
          Does a warmer, less pastel tonal range with slightly stronger imagery and one shared copper accent feel richer without losing restraint?
        </p>
      </div>

      <div class="offer-lab__comparison">
        {tonalVariants.map((variant) => (
          <section class="offer-lab__variant" aria-labelledby={`${variant.id}-title`}>
            <div class="offer-lab__variant-heading">
              <h3 id={`${variant.id}-title`}>{variant.label}</h3>
              <p>{variant.note}</p>
            </div>
            <div class={`offer-lab__grid offer-lab__grid--compact offer-lab__grid--${variant.id}`}>
              {cards.map((card) => (
                <article
                  class={`offer-lab__card offer-lab__card--${card.tone}`}
                  style={`--image-position: ${card.position}`}
                >
                  <div class="offer-lab__image" aria-hidden="true"></div>
                  <div class="offer-lab__wash" aria-hidden="true"></div>
                  <span class="offer-lab__number" aria-hidden="true">{card.number}</span>
                  <div class="offer-lab__copy">
                    <p class="offer-lab__eyebrow">{card.number} — {card.eyebrow}</p>
                    <h3>{card.title}</h3>
                    <p class="offer-lab__body">{card.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    {treatments.map((treatment) => (
      <section
        id={treatment.id}
        class="offer-lab__direction offer-lab__treatment"
        style="--board-image: url('/images/offer-concepts/scientific-imaging-board.png')"
      >
        <div class="offer-lab__direction-heading">
          <div>
            <p class="offer-lab__kicker">Colour prototype</p>
            <h2>{treatment.label}</h2>
          </div>
          <p>{treatment.note}</p>
        </div>

        <div class={`offer-lab__grid offer-lab__grid--${treatment.id}`}>
          {cards.map((card) => (
            <article
              class={`offer-lab__card offer-lab__card--${card.tone}`}
              style={`--image-position: ${card.position}`}
            >
              <div class="offer-lab__image" aria-hidden="true"></div>
              <div class="offer-lab__wash" aria-hidden="true"></div>
              <span class="offer-lab__number" aria-hidden="true">{card.number}</span>
              <div class="offer-lab__copy">
                <p class="offer-lab__eyebrow">{card.number} — {card.eyebrow}</p>
                <h3>{card.title}</h3>
                <p class="offer-lab__body">{card.body}</p>
                <div class="offer-lab__output">
                  <span>{card.outputLabel}</span>
                  <p>{card.output}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    {directions.map((direction) => (
      <section class="offer-lab__direction" style={`--board-image: url('${direction.image}')`}>
        <div class="offer-lab__direction-heading">
          <div>
            <p class="offer-lab__kicker">Generated family</p>
            <h2>{direction.name}</h2>
          </div>
          <p>{direction.note}</p>
        </div>

        <figure class="offer-lab__raw">
          <img src={direction.image} alt={`${direction.name}, raw four-panel generated image board`} />
          <figcaption>Raw image board: Audit · Build · Handover · Managed</figcaption>
        </figure>

        <div class="offer-lab__context-heading">
          <p class="offer-lab__kicker">Dimmed and in context</p>
          <p>Dark navy wash, edge vignette and the actual card copy.</p>
        </div>

        <div class="offer-lab__grid">
          {cards.map((card) => (
            <article class="offer-lab__card" style={`--image-position: ${card.position}`}>
              <div class="offer-lab__image" aria-hidden="true"></div>
              <div class="offer-lab__wash" aria-hidden="true"></div>
              <span class="offer-lab__number" aria-hidden="true">{card.number}</span>
              <div class="offer-lab__copy">
                <p class="offer-lab__eyebrow">{card.number} — {card.eyebrow}</p>
                <h3>{card.title}</h3>
                <p class="offer-lab__body">{card.body}</p>
                <div class="offer-lab__output">
                  <span>{card.outputLabel}</span>
                  <p>{card.output}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>
</Layout>

<style>
  .offer-lab {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 4rem) 7rem;
    background: #f1efea;
    color: #172232;
  }

  .offer-lab__intro,
  .offer-lab__direction {
    width: min(1380px, 100%);
    margin-inline: auto;
  }

  .offer-lab__intro > a {
    color: #8a5d3b;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .offer-lab__intro h1 {
    max-width: 14ch;
    margin: 1rem 0 0;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .offer-lab__lede {
    max-width: 52rem;
    margin: 1.5rem 0 0;
    color: #66707c;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .offer-lab__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .offer-lab__nav a {
    padding: 0.72rem 1rem;
    border: 1px solid rgba(22, 39, 53, 0.16);
    border-radius: 999px;
    color: #243546;
    font-size: 0.82rem;
    text-decoration: none;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .offer-lab__nav a:hover {
    border-color: rgba(138, 93, 59, 0.5);
    background: rgba(255, 255, 255, 0.5);
  }

  .offer-lab__kicker,
  .offer-lab__eyebrow,
  .offer-lab__output span {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .offer-lab__intro .offer-lab__kicker {
    margin-top: 3rem;
    color: #8a5d3b;
  }

  .offer-lab__direction {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .offer-lab__direction-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .offer-lab__direction-heading h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .offer-lab__direction-heading > p,
  .offer-lab__context-heading > p:last-child {
    margin: 0;
    color: #69727c;
    line-height: 1.55;
  }

  .offer-lab__raw {
    margin: 0;
  }

  .offer-lab__raw img {
    display: block;
    width: 100%;
    border-radius: 1.25rem;
    box-shadow: 0 2rem 5rem rgba(15, 27, 43, 0.12);
  }

  .offer-lab__raw figcaption {
    margin-top: 0.8rem;
    color: #7a828a;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .offer-lab__context-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin: clamp(3rem, 6vw, 5rem) 0 1.25rem;
  }

  .offer-lab__context-heading--first {
    margin-top: 0;
  }

  .offer-lab__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .offer-lab__card {
    position: relative;
    isolation: isolate;
    min-height: clamp(31rem, 46vw, 40rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1rem;
    background: #0d1b2d;
    box-shadow: 0 1.5rem 4rem rgba(11, 23, 39, 0.13);
  }

  .offer-lab__image,
  .offer-lab__wash {
    position: absolute;
    inset: 0;
  }

  .offer-lab__image {
    z-index: -3;
    background-image: var(--board-image);
    background-position: var(--image-position);
    background-size: 200% 200%;
    filter: saturate(0.68) contrast(0.9);
    transform: scale(1.02);
  }

  .offer-lab__wash {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(8, 20, 36, 0.92) 0%, rgba(8, 20, 36, 0.79) 55%, rgba(8, 20, 36, 0.6) 100%),
      linear-gradient(0deg, rgba(8, 20, 36, 0.78), rgba(8, 20, 36, 0.2) 70%);
  }

  .offer-lab__number {
    position: absolute;
    right: -0.03em;
    bottom: -0.2em;
    z-index: -1;
    color: rgba(255, 255, 255, 0.045);
    font-size: clamp(13rem, 25vw, 24rem);
    font-weight: 500;
    line-height: 0.7;
    letter-spacing: -0.1em;
  }

  .offer-lab__copy {
    display: flex;
    min-height: inherit;
    padding: clamp(2rem, 4.5vw, 4.25rem);
    flex-direction: column;
    justify-content: flex-end;
  }

  .offer-lab__eyebrow,
  .offer-lab__output span {
    color: #d49a69;
  }

  .offer-lab__copy h3 {
    max-width: 15ch;
    margin: 1rem 0 0;
    color: #fbfaf6;
    font-size: clamp(2.1rem, 4vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .offer-lab__body {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: rgba(245, 244, 239, 0.76);
    font-size: clamp(0.98rem, 1.5vw, 1.12rem);
    line-height: 1.65;
  }

  .offer-lab__output {
    max-width: 38rem;
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .offer-lab__output p {
    margin: 0.55rem 0 0;
    color: rgba(245, 244, 239, 0.88);
    line-height: 1.55;
  }

  .offer-lab__treatment {
    scroll-margin-top: 6.5rem;
  }

  .offer-lab__comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .offer-lab__variant {
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid rgba(22, 39, 53, 0.11);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.28);
  }

  .offer-lab__variant-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.45rem 1rem;
  }

  .offer-lab__variant-heading h3,
  .offer-lab__variant-heading p {
    margin: 0;
  }

  .offer-lab__variant-heading h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .offer-lab__variant-heading p {
    color: #6c747d;
    font-size: 0.78rem;
  }

  .offer-lab__grid--compact {
    gap: 0.65rem;
  }

  .offer-lab__grid--compact .offer-lab__card {
    min-height: clamp(20rem, 31vw, 28rem);
    border-radius: 0.75rem;
  }

  .offer-lab__grid--compact .offer-lab__copy {
    padding: clamp(1.2rem, 2.3vw, 2rem);
  }

  .offer-lab__grid--compact .offer-lab__copy h3 {
    font-size: clamp(1.45rem, 2.45vw, 2.35rem);
  }

  .offer-lab__grid--compact .offer-lab__body {
    margin-top: 0.9rem;
    font-size: clamp(0.78rem, 1.02vw, 0.94rem);
    line-height: 1.5;
  }

  .offer-lab__grid--compact .offer-lab__number {
    font-size: clamp(9rem, 14vw, 14rem);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__card {
    border-color: rgba(18, 35, 51, 0.1);
    background: var(--card-background);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__image {
    opacity: var(--image-opacity, 0.5);
    filter: saturate(var(--image-saturation, 0.48)) contrast(0.9);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__wash {
    background: var(--card-wash);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__copy h3 {
    color: var(--card-title);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__body {
    color: var(--card-body);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) :is(.offer-lab__eyebrow, .offer-lab__output span) {
    color: var(--card-accent);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__output {
    border-color: var(--card-line);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__output p {
    color: var(--card-output);
  }

  :is(.offer-lab__grid--ink, .offer-lab__grid--tonal, .offer-lab__grid--tonal-refined, .offer-lab__grid--mineral) .offer-lab__number {
    color: var(--card-number);
  }

  /* B1: one editorial paper stock, differentiated by the image tint rather than pastel panels. */
  .offer-lab__grid--ink :is(.offer-lab__card--audit, .offer-lab__card--build, .offer-lab__card--handover) {
    --card-background: #ede8df;
    --card-title: #152536;
    --card-body: rgba(27, 43, 57, 0.76);
    --card-accent: #865b3e;
    --card-line: rgba(23, 42, 57, 0.16);
    --card-output: rgba(22, 39, 53, 0.9);
    --card-number: rgba(20, 40, 56, 0.05);
    --image-opacity: 0.55;
  }

  .offer-lab__grid--ink .offer-lab__card--audit {
    --card-wash:
      linear-gradient(90deg, rgba(245, 240, 231, 0.97) 0%, rgba(236, 226, 211, 0.86) 57%, rgba(190, 143, 101, 0.46) 100%),
      linear-gradient(0deg, rgba(235, 226, 212, 0.76), rgba(242, 237, 228, 0.28) 70%);
  }

  .offer-lab__grid--ink .offer-lab__card--build {
    --card-wash:
      linear-gradient(90deg, rgba(245, 241, 233, 0.97) 0%, rgba(224, 230, 230, 0.86) 57%, rgba(102, 131, 145, 0.45) 100%),
      linear-gradient(0deg, rgba(221, 228, 228, 0.77), rgba(241, 237, 229, 0.28) 70%);
  }

  .offer-lab__grid--ink .offer-lab__card--handover {
    --card-wash:
      linear-gradient(90deg, rgba(245, 241, 233, 0.97) 0%, rgba(228, 226, 220, 0.87) 57%, rgba(89, 99, 105, 0.42) 100%),
      linear-gradient(0deg, rgba(227, 224, 217, 0.78), rgba(241, 237, 229, 0.28) 70%);
  }

  /* B2: a deliberate light-to-dark tonal sequence. */
  .offer-lab__grid--tonal .offer-lab__card--audit {
    --card-background: #eeeae2;
    --card-wash: linear-gradient(90deg, rgba(246, 242, 234, 0.97), rgba(234, 228, 217, 0.73));
    --card-title: #152536;
    --card-body: rgba(27, 43, 57, 0.76);
    --card-accent: #865b3e;
    --card-line: rgba(23, 42, 57, 0.16);
    --card-output: rgba(22, 39, 53, 0.9);
    --card-number: rgba(20, 40, 56, 0.05);
  }

  .offer-lab__grid--tonal .offer-lab__card--build {
    --card-background: #cbd4d8;
    --card-wash: linear-gradient(90deg, rgba(218, 226, 229, 0.95), rgba(177, 193, 200, 0.68));
    --card-title: #142638;
    --card-body: rgba(19, 39, 55, 0.76);
    --card-accent: #76533c;
    --card-line: rgba(17, 39, 56, 0.17);
    --card-output: rgba(17, 36, 51, 0.9);
    --card-number: rgba(19, 42, 59, 0.055);
  }

  .offer-lab__grid--tonal .offer-lab__card--handover {
    --card-background: #687683;
    --card-wash: linear-gradient(90deg, rgba(62, 77, 91, 0.94), rgba(87, 104, 117, 0.67));
    --card-title: #fbfaf6;
    --card-body: rgba(247, 246, 240, 0.76);
    --card-accent: #e0aa78;
    --card-line: rgba(255, 255, 255, 0.18);
    --card-output: rgba(249, 248, 243, 0.9);
    --card-number: rgba(255, 255, 255, 0.055);
  }

  /* B2 refined: warmer light tones, a clearer slate step and shared Layer copper. */
  .offer-lab__grid--tonal-refined .offer-lab__card {
    --card-accent: #b77b52;
    --image-opacity: 0.59;
    --image-saturation: 0.42;
  }

  .offer-lab__grid--tonal-refined .offer-lab__card--audit {
    --card-background: #e9e4db;
    --card-wash:
      linear-gradient(90deg, rgba(243, 238, 229, 0.95) 0%, rgba(232, 225, 213, 0.79) 58%, rgba(202, 189, 171, 0.54) 100%),
      linear-gradient(0deg, rgba(232, 225, 214, 0.7), rgba(239, 234, 225, 0.2) 72%);
    --card-title: #152536;
    --card-body: rgba(27, 43, 57, 0.78);
    --card-line: rgba(23, 42, 57, 0.17);
    --card-output: rgba(22, 39, 53, 0.91);
    --card-number: rgba(20, 40, 56, 0.052);
  }

  .offer-lab__grid--tonal-refined .offer-lab__card--build {
    --card-background: #bcc7ca;
    --card-wash:
      linear-gradient(90deg, rgba(204, 214, 216, 0.94) 0%, rgba(178, 193, 197, 0.78) 58%, rgba(139, 161, 168, 0.51) 100%),
      linear-gradient(0deg, rgba(177, 192, 196, 0.72), rgba(201, 211, 213, 0.18) 72%);
    --card-title: #142638;
    --card-body: rgba(19, 39, 55, 0.78);
    --card-line: rgba(17, 39, 56, 0.18);
    --card-output: rgba(17, 36, 51, 0.91);
    --card-number: rgba(19, 42, 59, 0.058);
  }

  .offer-lab__grid--tonal-refined .offer-lab__card--handover {
    --card-background: #536674;
    --card-wash:
      linear-gradient(90deg, rgba(49, 66, 79, 0.93) 0%, rgba(70, 89, 103, 0.76) 58%, rgba(82, 103, 116, 0.48) 100%),
      linear-gradient(0deg, rgba(47, 65, 78, 0.7), rgba(68, 86, 99, 0.16) 72%);
    --card-title: #fbfaf6;
    --card-body: rgba(247, 246, 240, 0.78);

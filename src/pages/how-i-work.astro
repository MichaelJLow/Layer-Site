---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  seo,
  howIWork,
  whatYouGet,
  humanControl,
  notOffered,
  discoveryCall,
} from '../config/site';
---

<Layout
  title={seo.howWeWork.title}
  description={seo.howWeWork.description}
>
  <div class="inner-v2 hiw">
    <PageHeader label="How we work" title="Find the opportunity. Build what works." subtitle={howIWork.intro} />

    <section class="hiw-band hiw-band--top">
      <div class="home-v2-shell hiw-choose">
        <div class="hiw-choose__col">
          <h2>{howIWork.chooseDiscovery.title}</h2>
          <p class="hiw-lede">{howIWork.chooseDiscovery.intro}</p>
          <dl class="hiw-signals">
            {howIWork.chooseDiscovery.rows.map((row) => (
              <div>
                <dt>{row.signal}</dt>
                <dd>{row.steer}</dd>
              </div>
            ))}
          </dl>
          <p class="hiw-note">{howIWork.chooseDiscovery.close}</p>
        </div>

        <div class="hiw-choose__col">
          <h2>{howIWork.chooseBuild.title}</h2>
          <dl class="hiw-signals">
            {howIWork.chooseBuild.rows.map((row) => (
              <div>
                <dt>{row.need}</dt>
                <dd>{row.offer}</dd>
              </div>
            ))}
          </dl>
          <p class="hiw-note">{howIWork.fitCheckNote}</p>
        </div>
      </div>
    </section>

    <section class="inner-v2-section hiw-path-section">
      <div class="home-v2-shell">
        <p class="home-v2-kicker">The path</p>
        <h2 class="hiw-h2">Start with one workflow. Choose what happens next.</h2>
        <ol class="hiw-path">
          {howIWork.path.map((item, index) => (
            <li>
              <span>0{index + 1}</span>
              <div>
                <h3>{item.step}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="hiw-band">
      <div class="home-v2-shell hiw-columns">
        <div>
          <p class="home-v2-kicker">What you get</p>
          <ul class="hiw-list">
            {whatYouGet.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="home-v2-kicker">What stays human controlled</p>
          <ul class="hiw-list">
            {humanControl.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="home-v2-kicker">What Layer does not do</p>
          <ul class="hiw-list hiw-list--muted">
            {notOffered.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <CtaBand
      kicker="Next step"
      title="Start with an AI Opportunity Audit"
      body={discoveryCall.intro}
      showFitCheck
    />
  </div>
</Layout>

<style>
  .hiw-band {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--ml-paper-raised);
    border-block: 1px solid var(--ml-line);
  }

  .hiw-band--top {
    border-top: 0;
  }

  .hiw-h2 {
    max-width: 22ch;
    margin: 0.9rem 0 0;
    color: var(--ml-ink);
    font-size: clamp(1.9rem, 3.4vw, 3.2rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .hiw-choose {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .hiw-choose h2 {
    margin: 0;
    color: var(--ml-ink);
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .hiw-lede {
    max-width: 34rem;
    margin: 0.85rem 0 0;
    color: var(--ml-muted);
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.65;
  }

  .hiw-signals {
    margin: 1.75rem 0 0;
  }

  .hiw-signals > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--ml-line);
    align-items: baseline;
  }

  .hiw-signals dt {
    margin: 0;
    color: var(--ml-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .hiw-signals dd {
    margin: 0;
    color: var(--ml-system);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .hiw-note {
    margin: 1.25rem 0 0;
    color: var(--ml-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .hiw-path-section {
    background: var(--ml-paper);
  }

  .hiw-path {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .hiw-path li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--ml-line);
  }

  .hiw-path span {
    color: var(--ml-system);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .hiw-path h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .hiw-path p {
    margin: 0.35rem 0 0;
    color: var(--ml-ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .hiw-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hiw-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .hiw-list li {
    padding-left: 0.9rem;
    border-left: 2px solid var(--ml-system);
    color: var(--ml-ink-soft);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .hiw-list--muted li {
    color: var(--ml-muted);
  }

  @media (max-width: 980px) {
    .hiw-choose,
    .hiw-columns {
      grid-template-columns: 1fr;
    }

    .hiw-signals dd {
      white-space: normal;
      text-align: right;
    }
  }
</style>

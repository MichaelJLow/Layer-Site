---
import Layout from '../components/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, seo, organizationJsonLd, secondaryCta } from '../config/site';

const principles = [
  {
    number: '01',
    title: 'Problem before platform',
    copy: [
      'We understand the workflow before choosing the technology.',
      'Sometimes the answer is straightforward automation. Sometimes AI adds useful judgement. Sometimes the process itself should change first.',
    ],
    icon: 'inspect',
  },
  {
    number: '02',
    title: 'Use the simplest thing that works',
    copy: [
      'Rules handle predictable decisions. Automation handles repeatable work. AI is used where language, ambiguity or judgement genuinely adds value.',
      'The goal is not to maximise the amount of AI. It is to build the right system for the problem.',
    ],
    icon: 'layers',
  },
  {
    number: '03',
    title: 'Keep control where it matters',
    copy: [
      'Routine work can move quickly, while important approvals, exceptions and consequential decisions stay with the people responsible for them.',
      'Automation should make work easier to operate, not harder to understand or control.',
    ],
    icon: 'control',
  },
] as const;

const jsonLd = [
  organizationJsonLd,
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.founder,
    jobTitle: `Founder, ${site.brand}`,
    url: `${site.url}/about/`,
    image: new URL('/images/me-headshot.png', site.url).href,
    email: `mailto:${site.email}`,
    sameAs: [site.linkedin],
    worksFor: {
      '@type': 'Organization',
      name: site.brand,
      url: `${site.url}/`,
    },
  },
];
---

<Layout
  title={seo.about.title}
  description={seo.about.description}
  jsonLd={jsonLd}
>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero__atmosphere" aria-hidden="true"></div>
      <div class="about-shell about-hero__grid">
        <div>
          <p class="about-kicker">About Layer</p>
          <h1 id="about-title">Better systems start with the process, not the technology.</h1>
        </div>
        <div class="about-hero__copy">
          <p>Layer helps growing businesses improve the work happening between their people and their tools.</p>
          <p>
            We start with how a process actually runs, find where time and effort are being lost, then design the
            simplest system that can improve it, using automation, AI and human judgement where each makes sense.
          </p>
          <a class="about-hero__link" href={secondaryCta.href}>
            {secondaryCta.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="about-why" aria-labelledby="why-title">
      <div class="about-shell about-why__grid">
        <div class="about-why__copy">
          <p class="about-kicker">Why Layer</p>
          <h2 id="why-title">
            Most businesses don’t need more software. They need better systems between the tools they already use.
          </h2>
          <p>
            As businesses grow, important processes spread across inboxes, spreadsheets, documents, software and people.
          </p>
          <p>
            The tools themselves may be perfectly good. The problem is everything happening between them: information
            being copied by hand, requests waiting for someone to notice them, approvals being chased and important
            context getting lost as work moves between teams.
          </p>
          <p>Layer exists to connect that work into systems that are easier to operate.</p>
        </div>

        <figure class="about-diagram" aria-hidden="true">
          <svg viewBox="0 0 560 320" fill="none">
            <path d="M128 44 C176 44, 214 118, 248 160" stroke="rgba(244,245,247,0.3)" stroke-width="1" />
            <path d="M118 98 C168 102, 216 138, 248 160" stroke="rgba(244,245,247,0.3)" stroke-width="1" />
            <path d="M128 160 C188 158, 226 160, 248 160" stroke="rgba(244,245,247,0.3)" stroke-width="1" />
            <path d="M114 222 C166 214, 216 182, 248 160" stroke="rgba(244,245,247,0.3)" stroke-width="1" />
            <path d="M128 276 C176 276, 214 202, 248 160" stroke="rgba(244,245,247,0.3)" stroke-width="1" />

            <rect x="248" y="140" width="78" height="40" rx="7" fill="rgba(16,27,43,0.35)" stroke="#e0a07a" stroke-width="1" />
            <text
              x="287"
              y="165"
              text-anchor="middle"
              fill="#e0a07a"
              font-family="IBM Plex Sans, system-ui, sans-serif"
              font-size="14"
              letter-spacing="-0.04em"
            >
              layer<tspan fill="#fff">.</tspan>
            </text>

            <path d="M326 160 H492" stroke="rgba(244,245,247,0.42)" stroke-width="1" />
            <circle cx="392" cy="160" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.7)" />
            <circle cx="442" cy="160" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.7)" />
            <circle cx="492" cy="160" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.7)" />
            <text
              x="442"
              y="188"
              text-anchor="middle"
              fill="rgba(244,245,247,0.5)"
              font-family="IBM Plex Mono, ui-monospace, monospace"
              font-size="9"
              letter-spacing="0.12em"
            >
              COORDINATED OPERATIONS
            </text>

            <g fill="rgba(244,245,247,0.58)" font-family="IBM Plex Mono, ui-monospace, monospace" font-size="10" letter-spacing="0.1em">
              <text x="112" y="48" text-anchor="end">TEAM</text>
              <text x="102" y="102" text-anchor="end">INBOX</text>
              <text x="112" y="164" text-anchor="end">CRM</text>
              <text x="98" y="226" text-anchor="end">DOCUMENTS</text>
              <text x="112" y="280" text-anchor="end">ACCOUNTING</text>
            </g>
            <circle cx="128" cy="44" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.55)" />
            <circle cx="118" cy="98" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.55)" />
            <circle cx="128" cy="160" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.55)" />
            <circle cx="114" cy="222" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.55)" />
            <circle cx="128" cy="276" r="3.25" fill="#101b2b" stroke="rgba(244,245,247,0.55)" />
          </svg>
        </figure>
      </div>
    </section>

    <section class="about-think" aria-labelledby="think-title">
      <div class="about-shell">
        <header class="about-think__head">
          <p class="about-kicker">How we think</p>
          <h2 id="think-title">Build what the workflow needs. Nothing more.</h2>
          <p>Good systems use the simplest level of technology that can reliably do the job.</p>
        </header>

        <div class="about-think__grid">
          {
            principles.map((principle) => (
              <article>
                <div class="about-think__icon" aria-hidden="true">
                  {principle.icon === 'inspect' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path d="M12 9.5h16.5L36 16v22.5H12V9.5Z" stroke="currentColor" stroke-width="1.4" />
                      <path d="M28.5 9.5V16H36" stroke="currentColor" stroke-width="1.4" />
                      <circle cx="23" cy="27.5" r="6.1" stroke="currentColor" stroke-width="1.4" />
                      <path d="M27.5 32 33 37.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                  )}
                  {principle.icon === 'layers' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <rect x="10" y="24" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
                      <rect x="15" y="16" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
                      <rect x="20" y="8" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  )}
                  {principle.icon === 'control' && (
                    <svg viewBox="0 0 48 48" fill="none">
                      <path d="M24 8v8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                      <rect x="16.5" y="16.5" width="15" height="15" rx="2.2" stroke="currentColor" stroke-width="1.4" />
                      <path d="M20.5 24.2 23.1 26.8 27.8 21.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M24 31.5V40" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                  )}
                </div>
                <p>{principle.number}</p>
                <h3>{principle.title}</h3>
                {principle.copy.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </article>
            ))
          }
        </div>

        <p class="about-think__note">Connect the tools. Coordinate the work. Keep people in control.</p>
      </div>
    </section>

    <section class="about-founder" aria-labelledby="founder-title">
      <div class="about-shell about-founder__grid">
        <figure class="about-founder__photo">
          <img
            src="/images/me-headshot.png"
            alt={`${site.founder}, founder of Layer`}
            width="1122"
            height="1402"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="about-founder__copy">
          <p class="about-kicker">Founder</p>
          <h2 id="founder-title">Built around how work actually happens.</h2>
          <p>
            Layer was founded by Michael Low, an engineer and systems builder with a background in technical inspection,
            quality assurance and operational problem-solving.
          </p>
          <p>
            That experience shaped how Layer works today: understand the process first, make the important decisions
            visible, design for the exceptions and build something people can actually rely on.
          </p>
          <p>
            Layer combines workflow design, automation, AI and systems integration to build practical systems around the
            way growing businesses already operate.
          </p>
        </div>
      </div>
    </section>

    <section class="about-cta" aria-labelledby="about-cta-title">
      <div class="about-cta__atmosphere" aria-hidden="true"></div>
      <div class="about-shell about-cta__grid">
        <div class="about-cta__copy">
          <p class="about-kicker">Start a conversation</p>
          <h2 id="about-cta-title">Where is work getting stuck?</h2>
          <p>
            Tell us about one process that isn’t working as well as it should. We’ll look at where time and effort are
            being lost and whether there’s a worthwhile way to improve it.
          </p>
          <p class="about-cta__note">No-cost AI Opportunity Session. No obligation.</p>
        </div>
        <ContactForm variant="home" />
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    --about-ink: #12151a;
    --about-navy: #1d3557;
    --about-muted: #5c6570;
    --about-paper: #f6f4ef;
    --about-copper: #e0a07a;
    color: var(--about-ink);
    background: var(--about-paper);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .about-page h1,
  .about-page h2,
  .about-page h3 {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .about-shell {
    width: min(92rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .about-kicker {
    margin: 0;
    color: var(--about-navy);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(6.5rem, 12vw, 10rem) clamp(4.5rem, 8vw, 7.5rem);
  }

  .about-hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 42% 55% at 8% 12%, rgba(224, 160, 122, 0.28), transparent 62%),
      radial-gradient(ellipse 38% 48% at 92% 8%, rgba(122, 158, 196, 0.22), transparent 58%),
      radial-gradient(ellipse 36% 50% at 78% 92%, rgba(156, 132, 186, 0.16), transparent 60%),
      linear-gradient(145deg, #f7f4ee, #e7ebeb);
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.72fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: end;
  }

  .about-hero h1 {
    max-width: 12ch;
    margin: 1.1rem 0 0;
    font-size: clamp(2.8rem, 6.4vw, 6.4rem);
    font-weight: 400;
    letter-spacing: -0.068em;
    line-height: 0.94;
  }

  .about-hero__copy p {
    margin: 0;
    color: var(--about-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.16rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .about-hero__copy p + p {
    margin-top: 1rem;
  }

  .about-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.6rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(29, 53, 87, 0.32);
    color: var(--about-ink);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .about-hero__link:hover {
    color: var(--about-navy);
    border-bottom-color: var(--about-navy);
  }

  .about-why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 9vw, 8.5rem);
    color: #f4f5f7;
    background: #101b2b;
  }

  .about-why::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 48% 62% at 6% 8%, rgba(194, 113, 86, 0.42), transparent 64%),
      radial-gradient(ellipse 46% 70% at 96% 100%, rgba(92, 137, 140, 0.34), transparent 64%),
      radial-gradient(ellipse 30% 40% at 70% 18%, rgba(132, 118, 168, 0.18), transparent 60%);
  }

  .about-why__grid,
  .about-why__copy,
  .about-diagram {
    position: relative;
  }

  .about-why .about-kicker {
    color: var(--about-copper);
  }

  .about-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.82fr);
    gap: clamp(2.5rem, 7vw, 6.5rem);
    align-items: center;
  }

  .about-why h2 {
    max-width: 16ch;
    margin: 1rem 0 1.6rem;
    font-size: clamp(2rem, 4.2vw, 3.7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .about-why__copy > p:not(.about-kicker) {
    max-width: 38rem;
    margin: 0 0 1.05rem;
    color: rgba(244, 245, 247, 0.74);
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.75;
  }

  .about-why__copy > p:last-child {
    margin-bottom: 0;
    color: rgba(244, 245, 247, 0.92);
  }

  .about-diagram {
    margin: 0;
  }

  .about-diagram svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-think {
    padding-block: clamp(5rem, 9vw, 8.5rem);
    background: #efede8;
  }

  .about-think__head h2 {
    max-width: 14ch;
    margin: 0.95rem 0 0;
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .about-think__head > p:last-child {
    max-width: 36rem;
    margin: 1.15rem 0 0;
    color: var(--about-muted);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .about-think__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
  }

  .about-think__grid article {
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    padding: 1.45rem 1.4rem 1.6rem;
    border: 1px solid rgba(29, 53, 87, 0.12);
    border-radius: 0.55rem;
    background: rgba(250, 249, 246, 0.55);
  }

  .about-think__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 1.15rem;
    color: var(--about-navy);
  }

  .about-think__icon svg {
    width: 2.15rem;
    height: 2.15rem;
  }

  .about-think__grid article > p:first-of-type {
    margin: 0;
    color: var(--about-navy);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .about-think__grid h3 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .about-think__grid article > p:not(:first-of-type) {
    margin: 0.75rem 0 0;
    color: var(--about-muted);
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .about-think__note {
    margin: 1.6rem 0 0;
    color: rgba(29, 53, 87, 0.58);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-founder {
    padding-block: clamp(5rem, 9vw, 8.5rem);
    background:
      radial-gradient(ellipse 40% 55% at 12% 20%, rgba(224, 160, 122, 0.14), transparent 62%),
      radial-gradient(ellipse 36% 48% at 88% 80%, rgba(122, 158, 196, 0.12), transparent 60%),
      var(--about-paper);
  }

  .about-founder__grid {
    display: grid;
    grid-template-columns: minmax(14rem, 0.4fr) minmax(22rem, 0.6fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }

  .about-founder__photo {
    margin: 0;
    overflow: hidden;
    max-width: 26rem;
    border: 1px solid rgba(29, 53, 87, 0.1);
    border-radius: 0.55rem;
    background: #d8d3c8;
    box-shadow: 0 24px 60px rgba(29, 53, 87, 0.1);
  }

  .about-founder__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0%;
    transform: scale(1.12);
    transform-origin: 50% 0%;
  }

  .about-founder h2 {
    max-width: 14ch;
    margin: 0.95rem 0 0;
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .about-founder__copy > p:not(.about-kicker) {
    max-width: 38rem;
    margin: 1.05rem 0 0;
    color: var(--about-muted);
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.75;
  }

  .about-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5.5rem, 10vw, 9rem);
    color: #f5f6f8;
    background: #142742;
  }

  .about-cta__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 45% 65% at 4% 14%, rgba(194, 113, 86, 0.52), transparent 62%),
      radial-gradient(ellipse 50% 75% at 100% 100%, rgba(92, 137, 140, 0.48), transparent 64%),
      linear-gradient(130deg, #152943, #1d3557 55%, #263f52);
  }

  .about-cta .about-kicker {
    color: var(--about-copper);
  }

  .about-cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(26rem, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .about-cta h2 {
    max-width: 10ch;
    margin: 1rem 0 0;
    font-size: clamp(2.8rem, 5.6vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.068em;
    line-height: 0.95;
  }

  .about-cta__copy > p:not(.about-kicker, .about-cta__note) {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.03rem;
    font-weight: 300;
    line-height: 1.72;
  }

  .about-cta__note {
    margin: 2rem 0 0;
    color: rgba(255, 255, 255, 0.52);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .about-shell {
      width: min(100% - 2rem, 46rem);
    }

    .about-hero__grid,
    .about-why__grid,
    .about-think__grid,
    .about-founder__grid,
    .about-cta__grid {
      grid-template-columns: 1fr;
    }

    .about-hero h1,
    .about-why h2,
    .about-think__head h2,
    .about-founder h2 {
      max-width: none;
    }

    .about-think__grid article {
      min-height: 0;
    }

    .about-founder__photo {
      max-width: 22rem;
    }

    .about-cta__grid {
      gap: 3rem;
    }
  }
</style>

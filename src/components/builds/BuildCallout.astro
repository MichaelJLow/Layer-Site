---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="build-callout">
  <h3>{title}</h3>
  <div class="build-callout__body">
    <slot />
  </div>
</aside>

<style>
  .build-callout {
    width: min(100%, 46rem);
    margin: clamp(2rem, 5vw, 3rem) auto;
    padding: 1.35rem 1.4rem 1.45rem;
    border: 1px solid rgba(29, 53, 87, 0.12);
    border-left: 3px solid #1d3557;
    border-radius: 0.5rem;
    background: #f7f6f2;
    color: #1d3557;
  }

  .build-callout h3 {
    margin: 0;
    color: #12151a;
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .build-callout__body :global(p) {
    margin: 0.75rem 0 0;
    color: #1d3557;
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .build-callout__body :global(p:first-child) {
    margin-top: 0.85rem;
  }
</style>

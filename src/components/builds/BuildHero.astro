---
import VideoDemo from '../VideoDemo.astro';
import type { BuildEntry } from '../../utils/content';

interface Props {
  build: BuildEntry;
}

const { build } = Astro.props;
const { title, description, status, category, role, stack, proofLine, coverImage, videoUrl } = build.data;
---

<header class="build-hero">
  <div class="build-hero__shell">
    <div class="build-hero__heading">
      <div class="build-hero__eyebrow">
        <p class="build-hero__kicker">{category}</p>
        <p class="build-hero__status"><span aria-hidden="true"></span>{status}</p>
      </div>
      <h1>{title}</h1>
      <p class="build-hero__lede">{description}</p>
    </div>

    <dl class="build-hero__facts">
      <div class="build-hero__fact">
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      {stack.length > 0 && (
        <div class="build-hero__fact">
          <dt>Stack</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
      )}
      {proofLine && (
        <div class="build-hero__proof">
          <dt>First six live days</dt>
          <dd>{proofLine}</dd>
        </div>
      )}
    </dl>

    {
      coverImage && (
        <figure class="build-hero__cover">
          <img
            src={coverImage}
            alt={`${title} cover`}
            width="1600"
            height="1000"
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }

    {videoUrl && <VideoDemo src={videoUrl} title={`${title} walkthrough`} />}
  </div>
</header>

<style>
  .build-hero {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background:
      radial-gradient(ellipse 42% 55% at 8% 12%, rgba(224, 160, 122, 0.22), transparent 62%),
      radial-gradient(ellipse 38% 48% at 92% 8%, rgba(122, 158, 196, 0.18), transparent 58%),
      linear-gradient(145deg, #f7f4ee, #e7ebeb);
  }

  .build-hero__shell {
    width: min(76rem, calc(100% - 3rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.62fr);
    column-gap: clamp(3rem, 7vw, 6.5rem);
    align-items: end;
  }

  .build-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.2rem;
  }

  .build-hero__kicker,
  .build-hero__status {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .build-hero__kicker {
    color: var(--builds-navy, #1d3557);
  }

  .build-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--builds-muted, #5c6570);
  }

  .build-hero__status span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #27734f;
  }

  .build-hero h1 {
    max-width: 13ch;
    margin: 1.25rem 0 0;
    font-size: clamp(3rem, 6vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.96;
  }

  .build-hero__lede {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--builds-soft, #505a66);
    font-size: clamp(1.02rem, 1.4vw, 1.12rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .build-hero__facts {
    display: grid;
    gap: 1.4rem;
    margin: 0;
  }

  .build-hero__fact {
    padding-top: 0.9rem;
    border-top: 1px solid rgba(29, 53, 87, 0.14);
  }

  .build-hero__facts dt {
    color: var(--builds-muted, #5c6570);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .build-hero__facts dd {
    margin: 0.25rem 0 0;
    color: var(--builds-ink, #12151a);
    font-size: 0.9rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .build-hero__proof {
    padding: 1rem 1.05rem;
    border: 1px solid rgba(29, 53, 87, 0.14);
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.42);
  }

  .build-hero__cover {
    grid-column: 1 / -1;
    width: min(100%, 72rem);
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
  }

  .build-hero__cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(29, 53, 87, 0.14);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 22px 55px rgba(29, 53, 87, 0.1);
  }

  .build-hero :global(.my-8) {
    max-width: 72rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
  }

  @media (max-width: 800px) {
    .build-hero__shell {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.75rem;
    }

    .build-hero h1 {
      max-width: 14ch;
    }

    .build-hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .build-hero__proof {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .build-hero {
      padding-block: 3.75rem;
    }

    .build-hero__shell {
      width: min(100% - 2rem, 76rem);
    }

    .build-hero h1 {
      max-width: none;
      font-size: clamp(2.75rem, 13vw, 4rem);
    }

    .build-hero__facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .build-hero__proof {
      grid-column: auto;
    }
  }
</style>

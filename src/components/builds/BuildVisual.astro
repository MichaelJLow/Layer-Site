---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  priority?: boolean;
  wide?: boolean;
}

const { src, alt, width, height, caption, priority = false, wide = true } = Astro.props;
---

<figure class:list={['build-visual', wide && 'build-visual--wide']}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .build-visual {
    width: min(100%, 46rem);
    margin: clamp(2rem, 5vw, 3.5rem) auto;
  }

  .build-visual--wide {
    width: min(100%, 72rem);
  }

  .build-visual img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(29, 53, 87, 0.14);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 18px 48px rgba(29, 53, 87, 0.08);
  }

  .build-visual figcaption {
    margin-top: 0.7rem;
    color: #5c6570;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
</style>

---
import type { BuildEntry } from '../../utils/content';

interface Props {
  build: BuildEntry;
}

const { build } = Astro.props;
const { title, description, status, category, role, stack, proofLine, cardImage, coverImage } = build.data;
const image = cardImage || coverImage;
---

<article class="build-card">
  {
    image ? (
      <a class="build-card__media" href={`/builds/${build.slug}`}>
        <img
          src={image}
          alt={`${title} preview`}
          width="1448"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <a class="build-card__media build-card__media--empty" href={`/builds/${build.slug}`} aria-hidden="true">
        <span>{title.charAt(0)}</span>
      </a>
    )
  }

  <div class="build-card__copy">
    <div class="build-card__meta">
      <p class="build-card__kicker">{category}</p>
      <p class="build-card__status">{status}</p>
    </div>
    <h2>
      <a href={`/builds/${build.slug}`}>{title}</a>
    </h2>
    <p class="build-card__desc">{description}</p>
    <dl class="build-card__facts">
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      {
        stack.length > 0 && (
          <div>
            <dt>Stack</dt>
            <dd>{stack.join(' · ')}</dd>
          </div>
        )
      }
    </dl>
    {proofLine && <p class="build-card__proof">{proofLine}</p>}
    <a class="build-card__link" href={`/builds/${build.slug}`}>
      View build <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .build-card {
    --builds-ink: #12151a;
    --builds-navy: #1d3557;
    --builds-muted: #5c6570;
    --builds-soft: #505a66;
    --builds-line: rgba(29, 53, 87, 0.14);
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    overflow: hidden;
    border: 1px solid var(--builds-line);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 18px 48px rgba(29, 53, 87, 0.07);
  }

  .build-card__media {
    display: block;
    min-height: 18rem;
    overflow: hidden;
    background: #172b47;
  }

  .build-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .build-card__media--empty {
    display: grid;
    place-items: center;
    color: rgba(246, 244, 239, 0.22);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: clamp(4rem, 8vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    text-decoration: none;
  }

  .build-card__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 2.6rem);
  }

  .build-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }

  .build-card__kicker,
  .build-card__status {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .build-card__kicker {
    color: var(--builds-navy);
  }

  .build-card__status {
    color: var(--builds-muted);
  }

  .build-card h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .build-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .build-card__desc {
    margin: 1rem 0 0;
    color: var(--builds-soft);
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .build-card__facts {
    display: grid;
    gap: 0.7rem;
    margin: 1.25rem 0 0;
  }

  .build-card__facts div {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .build-card__facts dt {
    color: var(--builds-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .build-card__facts dd {
    margin: 0;
    color: var(--builds-ink);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .build-card__proof {
    margin: 1rem 0 0;
    color: var(--builds-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .build-card__link {
    align-self: start;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--builds-navy);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .build-card__link span {
    margin-left: 0.4rem;
  }

  @media (max-width: 800px) {
    .build-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .build-card__media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }
</style>

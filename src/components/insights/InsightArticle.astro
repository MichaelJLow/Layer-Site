---
import type { CollectionEntry } from 'astro:content';
import ContentClosing from '../ContentClosing.astro';

interface Props {
  insight: CollectionEntry<'insights'>;
  readingMinutes: number;
}

const { insight } = Astro.props;
const { data } = insight;
const seriesLabel = data.seriesNumber
  ? `${data.series} · ${String(data.seriesNumber).padStart(2, '0')}`
  : data.series;
const railSummary = data.railSummary || data.description;
const bodyCaption =
  data.bodyImageCaption ||
  (data.bodyImageAlt
    ? `${data.bodyImageAlt} Select to view at full size.`
    : 'Example workflow screenshot. Select to view at full size.');
---

<div class="insight-article">
  <header class="insight-hero">
    <div class="insight-shell">
      <p class="insight-series">{seriesLabel}</p>
      <h1>{data.title}</h1>
      <p class="insight-hero__lede">{data.description}</p>
    </div>
  </header>

  <article class="insight-body">
    <div class="insight-shell insight-body__grid">
      <aside class="insight-rail" aria-label="Article information">
        <p>In this article</p>
        <span>{railSummary}</span>
        <a href="/#contact">Discuss this workflow <b aria-hidden="true">→</b></a>
      </aside>

      <div class="insight-prose">
        {data.bodyImage && (
          <figure class="insight-body__figure">
            <a href={data.bodyImage} target="_blank" rel="noopener noreferrer" aria-label="Open workflow screenshot at full size">
              <img src={data.bodyImage} alt={data.bodyImageAlt || ''} width="1024" height="800" loading="lazy" decoding="async" />
            </a>
            <figcaption>{bodyCaption}</figcaption>
          </figure>
        )}
        <slot />
        {data.disclaimer && <p class="insight-disclaimer">{data.disclaimer}</p>}
      </div>
    </div>
  </article>

  <ContentClosing
    title={data.closing.title}
    body={data.closing.body}
    label={data.closing.label}
    href={data.closing.href}
  />
</div>

<style>
  .insight-article {
    --insight-ink: #12151a;
    --insight-soft: #4f5965;
    --insight-muted: #737b85;
    --insight-navy: #1d3557;
    --insight-paper: #f6f4ef;
    --insight-line: rgba(29, 53, 87, 0.14);
    color: var(--insight-ink);
    background: var(--insight-paper);
  }

  .insight-shell {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
  }

  .insight-hero {
    padding: clamp(4rem, 8vw, 7.5rem) 0 2.5rem;
    border-bottom: 1px solid var(--insight-line);
    background: var(--insight-paper);
  }

  .insight-series,
  .insight-rail > p {
    margin: 0;
    color: var(--insight-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .insight-hero h1 {
    max-width: 920px;
    margin: 1rem 0 0;
    color: var(--insight-ink);
    font-size: clamp(3rem, 7vw, 6.6rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .insight-hero__lede {
    max-width: 800px;
    margin: 1.5rem 0 0;
    color: var(--insight-soft);
    font-size: clamp(1.1rem, 2vw, 1.42rem);
    font-weight: 400;
    line-height: 1.55;
  }

  .insight-body__figure {
    margin: 0 0 clamp(3rem, 6vw, 5rem);
  }

  .insight-body__figure a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--insight-line);
    border-radius: 0.55rem;
    background: #fff;
    box-shadow: 0 22px 55px rgba(29, 53, 87, 0.12);
  }

  .insight-body__figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .insight-body__figure figcaption {
    margin-top: 0.65rem;
    color: var(--insight-muted);
    font-size: 0.72rem;
  }

  .insight-body {
    padding-block: clamp(3.5rem, 7vw, 7rem) 0;
  }

  .insight-body__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
  }

  .insight-rail {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .insight-rail span {
    max-width: 17rem;
    color: var(--insight-muted);
    font-size: 0.82rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .insight-rail a {
    color: var(--insight-navy);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
  }

  .insight-rail b {
    margin-left: 0.35rem;
  }

  .insight-prose {
    width: min(100%, 47rem);
  }

  .insight-disclaimer {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    color: var(--insight-muted);
    font-size: 0.78rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .insight-prose :global(> p:first-child) {
    color: var(--insight-ink);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.48;
  }

  .insight-prose :global(p) {
    margin: 0 0 1.35rem;
    color: var(--insight-soft);
    font-size: 1.03rem;
    font-weight: 300;
    line-height: 1.82;
  }

  .insight-prose :global(h2) {
    margin: clamp(4rem, 8vw, 6.5rem) 0 1.35rem;
    color: var(--insight-ink);
    font-size: clamp(2rem, 4vw, 3.35rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .insight-prose :global(ul),
  .insight-prose :global(ol) {
    display: grid;
    gap: 0.7rem;
    margin: 1.5rem 0 2rem;
    padding-left: 1.35rem;
  }

  .insight-prose :global(li) {
    padding-left: 0.4rem;
    color: var(--insight-soft);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .insight-prose :global(blockquote) {
    margin: clamp(3rem, 6vw, 5rem) 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--insight-line);
    border-left: 3px solid var(--insight-navy);
    background:
      radial-gradient(circle at 95% 10%, rgba(198, 137, 111, 0.14), transparent 35%),
      #eef0ef;
  }

  .insight-prose :global(blockquote p) {
    margin: 0;
    color: var(--insight-ink);
    font-size: clamp(1.18rem, 2vw, 1.5rem);
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .insight-body__grid {
      grid-template-columns: 1fr;
    }

    .insight-rail {
      position: static;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--insight-line);
    }
  }

  @media (max-width: 560px) {
    .insight-shell {
      width: min(100% - 2rem, 92rem);
    }

    .insight-connections {
      grid-auto-flow: column;
      grid-auto-columns: minmax(9rem, 1fr);
      grid-template-columns: unset;
      overflow-x: auto;
      padding-bottom: 0.35rem;
    }
  }
</style>

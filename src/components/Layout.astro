---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import AmbientBackground from './AmbientBackground.astro';
import { site, accentTheme } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep design sandboxes and utility routes out of search results. */
  noindex?: boolean;
  /** Exact robots directive. When set, used as-is and does not change lab/noindex behaviour. */
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = '/images/og-default.jpg',
  ogImageAlt = `${site.brand} | ${site.practice}`,
  noindex = false,
  robots,
  jsonLd,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

/** Design sandboxes live at /*-lab and are never indexed. */
const hideFromSearch = noindex || Astro.url.pathname.includes('-lab');
const robotsContent = robots ?? (hideFromSearch ? 'noindex, nofollow' : undefined);

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const serializeJsonLd = (block: Record<string, unknown>) =>
  JSON.stringify(block).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
---

<!doctype html>
<html lang="en" data-accent={accentTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.founder} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/layer-icon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/layer-icon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1d3557" />
    <meta name="application-name" content="Layer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={serializeJsonLd(block)} />
      ))
    }
    <title>{title}</title>
    <Analytics mode="production" />
  </head>
  <body class="relative min-h-screen flex flex-col">
    <AmbientBackground />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Navbar />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

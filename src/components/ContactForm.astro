---
interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const formClass = variant === 'home' ? 'layer-form' : 'contact-form';
---

<form class={formClass} data-review-form novalidate>
  <input class="contact-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class={`${formClass}__row`}>
    <label>
      <span>Name</span>
      <input name="name" type="text" autocomplete="name" placeholder="Your name" required />
    </label>
    <label>
      <span>Work email</span>
      <input name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
    </label>
  </div>
  <label>
    <span>Company <em>(optional)</em></span>
    <input name="company" type="text" autocomplete="organization" placeholder="Company name" />
  </label>
  <label>
    <span>Where is work getting stuck?</span>
    <textarea
      name="message"
      rows="4"
      required
      placeholder="The process, the tools, and what the team is still doing by hand."></textarea>
  </label>
  <button class={`${formClass}__submit`} type="submit">
    Request a no-cost AI Opportunity Session <span aria-hidden="true">→</span>
  </button>
  <p class={`${formClass}__trust`}>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <rect x="3.25" y="7.25" width="9.5" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.2" />
      <path d="M5.2 7.25V5.4a2.8 2.8 0 0 1 5.6 0v1.85" fill="none" stroke="currentColor" stroke-width="1.2" />
    </svg>
    Your information is secure and never shared.
  </p>
  <p class={`${formClass}__status`} data-form-status aria-live="polite"></p>
</form>

<script>
  const CONTACT_EMAIL = 'contact@workwithlayer.com';
  const forms = document.querySelectorAll<HTMLFormElement>('[data-review-form]');

  function markSent(form: HTMLFormElement, status: HTMLElement | null) {
    form.reset();
    if (status) {
      status.textContent = 'Thanks. We will reply within one working day to arrange the conversation.';
    }
  }

  async function sendViaApi(payload: Record<string, string>) {
    const response = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload),
    });
    return response.json().catch(() => ({ ok: false, fallback: true }));
  }

  async function sendViaFormSubmit(payload: Record<string, string>) {
    const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(CONTACT_EMAIL)}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        name: payload.name,
        email: payload.email,
        company: payload.company,
        message: payload.message,
        _subject: `AI Opportunity Session request from ${payload.company || payload.name}`,
        _template: 'table',
        _captcha: 'false',
        _replyto: payload.email,
      }),
    });
    const result = await response.json().catch(() => ({ success: 'false' }));
    if (!response.ok || result.success === false || result.success === 'false') {
      throw new Error(result.message || `Something went wrong sending the request. Email ${CONTACT_EMAIL} and it will reach us directly.`);
    }
  }

  forms.forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        company: String(data.get('company') || '').trim(),
        message: String(data.get('message') || '').trim(),
        website: String(data.get('website') || '').trim(),
      };

      if (!payload.name || !payload.email || !payload.message) {
        if (status) status.textContent = 'Please add your name, work email, and a short note about the workflow.';
        return;
      }

      if (payload.website) {
        markSent(form, status);
        return;
      }

      if (button) button.disabled = true;
      if (status) status.textContent = 'Sending…';

      try {
        const result = await sendViaApi(payload);
        if (result.ok) {
          markSent(form, status);
          return;
        }

        await sendViaFormSubmit(payload);
        markSent(form, status);
      } catch (error) {
        if (status) {
          status.textContent =
            error instanceof Error
              ? error.message
              : `Something went wrong. Email ${CONTACT_EMAIL} and it will reach us directly.`;
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

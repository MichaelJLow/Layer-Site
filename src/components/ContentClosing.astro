---
interface Props {
  kicker?: string;
  title: string;
  body: string;
  label: string;
  href: string;
}

const {
  kicker = 'Your first step',
  title,
  body,
  label,
  href,
} = Astro.props;
---

<section class="content-closing" aria-labelledby="content-closing-title">
  <div class="content-closing__grid">
    <div>
      <p class="content-closing__kicker">{kicker}</p>
      <h2 id="content-closing-title">{title}</h2>
    </div>
    <div>
      <p>{body}</p>
      <a class="content-closing__button" href={href}>
        {label} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .content-closing {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    color: #f4f5f7;
    background:
      radial-gradient(circle at 4% 5%, rgba(191, 117, 90, 0.4), transparent 34%),
      linear-gradient(135deg, #172b47, #1d3557 58%, #354e62);
  }

  .content-closing__grid {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
  }

  .content-closing__kicker {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .content-closing h2 {
    max-width: 18ch;
    margin: 1rem 0 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .content-closing__grid > div:last-child > p {
    margin: 0 0 1.4rem;
    color: rgba(255, 255, 255, 0.74);
    font-weight: 300;
    line-height: 1.7;
  }

  .content-closing__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.35rem;
    padding: 0.85rem 1.15rem;
    border-radius: 0.3rem;
    color: #1d3557;
    background: #f5f3ee;
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .content-closing__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .content-closing__grid {
      width: min(100% - 2rem, 92rem);
    }
  }
</style>

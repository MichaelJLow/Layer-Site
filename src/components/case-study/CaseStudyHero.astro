---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { ProjectEntry } from '../../utils/content';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const {
  title,
  description,
  descriptionExtra,
  heroLabel = 'Workflow case study',
  liveUrl,
  liveLabel = 'View live site',
  liveCtaNote,
  coverImage,
  coverFit,
  coverPosition,
  coverFrame,
  coverFrameLabel,
  showHeroCover,
  github,
  demoUrl,
  demoLabel = 'Try demo',
  caseOverview,
} = project.data;

const secondaryCta = demoUrl
  ? { href: demoUrl, label: demoLabel, externalIcon: false }
  : !liveUrl && github
    ? { href: github, label: 'View repo', externalIcon: true }
    : null;

const coverRetina = coverImage?.replace(/\.(png|jpe?g|webp)$/i, '@2x.$1');
const hasRetinaCover =
  Boolean(coverImage && coverRetina) &&
  existsSync(join(process.cwd(), 'public', coverRetina!.replace(/^\//, '')));
---

<header class="case-study-hero">
  <div class="container-main">
    <div class={`case-study-hero__copy${caseOverview ? ' case-study-hero__copy--overview' : ''}`}>
      <p class="case-study-hero__label">{heroLabel}</p>
      <h1>{title}</h1>

      {
        caseOverview ? (
          <div class="case-study-hero__overview">
            <div class="case-study-hero__overview-copy">
              <p class="case-study-hero__lede">{caseOverview.lead}</p>
              <p class="case-study-hero__overview-body">{caseOverview.body}</p>
              {caseOverview.note && <p class="case-study-hero__overview-note">{caseOverview.note}</p>}

              <div class="case-study-hero__actions">
                {liveUrl && (
                  <a class="case-study-hero__btn case-study-hero__btn--primary" href={liveUrl} target="_blank" rel="noopener noreferrer">
                    <span>
                      {liveLabel} <span aria-hidden="true">&rarr;</span>
                    </span>
                    {liveCtaNote && <small>{liveCtaNote}</small>}
                  </a>
                )}
                {secondaryCta && (
                  <a class="case-study-hero__btn case-study-hero__btn--secondary" href={secondaryCta.href} target="_blank" rel="noopener noreferrer">
                    <span>
                      {secondaryCta.label}{' '}
                      <span aria-hidden="true">{secondaryCta.externalIcon ? '↗' : '→'}</span>
                    </span>
                  </a>
                )}
              </div>
            </div>

            <div class="case-study-hero__facts-wrap">
              {caseOverview.factsHeading && (
                <p class="case-study-hero__facts-heading">{caseOverview.factsHeading}</p>
              )}
              <dl class="case-study-hero__facts">
                {
                  caseOverview.facts.map((fact) => (
                    <div class="case-study-hero__fact">
                      <dt>{fact.label}</dt>
                      <dd>
                        {
                          fact.href ? (
                            <a href={fact.href} target="_blank" rel="noopener noreferrer">
                              {fact.value}
                            </a>
                          ) : (
                            fact.value
                          )
                        }
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        ) : (
          <>
            <p class="case-study-hero__lede">{description}</p>
            {descriptionExtra && <p class="case-study-hero__intro">{descriptionExtra}</p>}

            <div class="case-study-hero__actions">
              {liveUrl && (
                <a class="case-study-hero__btn case-study-hero__btn--primary" href={liveUrl} target="_blank" rel="noopener noreferrer">
                  <span>
                    {liveLabel} <span aria-hidden="true">&rarr;</span>
                  </span>
                  {liveCtaNote && <small>{liveCtaNote}</small>}
                </a>
              )}
              {secondaryCta && (
                <a class="case-study-hero__btn case-study-hero__btn--secondary" href={secondaryCta.href} target="_blank" rel="noopener noreferrer">
                  <span>
                    {secondaryCta.label}{' '}
                    <span aria-hidden="true">{secondaryCta.externalIcon ? '↗' : '→'}</span>
                  </span>
                </a>
              )}
            </div>
          </>
        )
      }
    </div>

    {
      coverImage && showHeroCover && (
        <div
          class={`case-study-hero__artifact${coverFrame ? ` case-study-hero__artifact--${coverFrame}` : ''}`}
        >
          {coverFrame && (
            <div class="product-frame__bar" aria-hidden="true">
              <span class="product-frame__dots"><i></i><i></i><i></i></span>
              <span class="product-frame__label">{coverFrameLabel ?? title}</span>
              <span></span>
            </div>
          )}
          <div class="case-study-hero__artifact-media">
            {
              hasRetinaCover ? (
                <picture>
                  <source srcset={`${coverRetina} 2x`} type="image/png" />
                  <img
                    src={coverImage}
                    srcset={`${coverImage} 1x, ${coverRetina} 2x`}
                    alt={`${title} cover`}
                    loading="eager"
                    decoding="async"
                    sizes="(min-width: 1152px) 1152px, 100vw"
                    style={`object-fit: ${coverFit ?? 'cover'}; object-position: ${coverPosition ?? 'center'};`}
                  />
                </picture>
              ) : (
                <img
                  src={coverImage}
                  alt={`${title} cover`}
                  loading="eager"
                  decoding="async"
                  style={`object-fit: ${coverFit ?? 'cover'}; object-position: ${coverPosition ?? 'center'};`}
                />
              )
            }
          </div>
        </div>
      )
    }
  </div>
</header>

<style>
  .case-study-hero {
    background: var(--ml-paper);
    border-bottom: 1px solid var(--ml-line);
    color: var(--ml-ink);
    padding: clamp(4rem, 8vw, 7.5rem) 0 2.5rem;
  }

  .case-study-hero :global(.container-main) {
    width: var(--ml-shell);
    max-width: none;
    padding-inline: 0;
  }

  .case-study-hero__label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .case-study-hero__label {
    color: var(--ml-muted);
    margin: 0;
  }

  .case-study-hero__copy {
    max-width: 920px;
  }

  .case-study-hero__copy--overview {
    max-width: none;
  }

  .case-study-hero h1 {
    color: var(--ml-ink);
    font-family: var(--font-sans);
    font-size: clamp(3rem, 7vw, 6.6rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.95;
    margin: 1rem 0 0;
    max-width: 920px;
    text-wrap: balance;
  }

  .case-study-hero__lede {
    color: var(--ml-ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.42rem);
    font-weight: 400;
    line-height: 1.55;
    margin: 1.5rem 0 0;
    max-width: 800px;
  }

  .case-study-hero__intro {
    border-left: 1px solid var(--ml-line-strong);
    color: var(--ml-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin: 1.25rem 0 0;
    max-width: 780px;
    padding-left: 1.15rem;
  }

  .case-study-hero__overview {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .case-study-hero__overview .case-study-hero__lede {
    margin-top: 0;
    max-width: 42rem;
  }

  .case-study-hero__overview-body {
    color: var(--ml-ink-soft);
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    font-weight: 400;
    line-height: 1.68;
    margin: 1.2rem 0 0;
    max-width: 46rem;
  }

  .case-study-hero__overview-note {
    color: var(--ml-muted);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.62;
    margin: 1.15rem 0 0;
    max-width: 42rem;
  }

  .case-study-hero__facts-wrap {
    align-self: start;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ml-paper-raised) 92%, white) 0%,
      var(--ml-paper-raised) 100%
    );
    border: 1px solid var(--ml-line);
    border-left: 3px solid var(--ml-clay);
    border-radius: 0.5rem;
    box-shadow:
      0 16px 36px rgba(18, 18, 16, 0.07),
      inset 0 1px 0 color-mix(in srgb, white 60%, transparent);
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .case-study-hero__facts {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .case-study-hero__facts-heading {
    margin: 0 0 1.1rem;
    color: var(--ml-ink);
    font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .case-study-hero__fact {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--ml-line);
  }

  .case-study-hero__fact:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .case-study-hero__fact:last-child {
    padding-bottom: 0;
  }

  .case-study-hero__facts dt {
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study-hero__facts dd {
    color: var(--ml-ink);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: clamp(0.96rem, 1.15vw, 1.05rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.42;
    margin: 0;
  }

  .case-study-hero__facts dd a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ml-ink) 28%, transparent);
    text-underline-offset: 0.18em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .case-study-hero__facts dd a:hover {
    color: var(--ml-clay);
    text-decoration-color: color-mix(in srgb, var(--ml-clay) 55%, transparent);
  }

  .case-study-hero__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .case-study-hero__btn {
    align-items: center;
    border-radius: 0.35rem;
    display: inline-flex;
    font-family: var(--font-sans, system-ui, sans-serif);
    gap: 0.55rem;
    justify-content: center;
    letter-spacing: 0.07em;
    min-height: 3.2rem;
    padding: 0.95rem 1.45rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms ease,
      border-color 220ms ease,
      background 220ms ease,
      gap 220ms ease;
  }

  .case-study-hero__btn span {
    align-items: center;
    display: inline-flex;
    font-size: clamp(0.74rem, 1.1vw, 0.84rem);
    font-weight: 600;
    gap: 0.55rem;
    line-height: 1.2;
  }

  .case-study-hero__btn span span[aria-hidden='true'] {
    color: var(--ml-clay);
    transition: transform 220ms ease;
  }

  .case-study-hero__btn--primary {
    position: relative;
    overflow: hidden;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 4.5rem;
    padding: 1rem 1.55rem;
    border: 1px solid color-mix(in srgb, var(--ml-ink) 12%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 28%, var(--ml-paper-raised)) 0%,
      var(--ml-paper-raised) 55%,
      var(--ml-paper) 100%
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 50%, transparent),
      0 8px 20px rgba(18, 18, 16, 0.07);
    color: var(--ml-ink);
  }

  .case-study-hero__btn--primary:hover,
  .case-study-hero__btn--primary:focus-visible {
    gap: 0.45rem;
    border-color: color-mix(in srgb, var(--color-amber-bright) 45%, var(--ml-line));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 34%, var(--ml-paper-raised)) 0%,
      var(--ml-paper-raised) 55%,
      color-mix(in srgb, var(--color-amber-bright) 22%, var(--ml-paper)) 100%
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 58%, transparent),
      0 10px 24px rgba(18, 18, 16, 0.09);
    transform: translateY(-2px);
  }

  .case-study-hero__btn--primary:hover span span[aria-hidden='true'],
  .case-study-hero__btn--primary:focus-visible span span[aria-hidden='true'] {
    transform: translateX(2px);
  }

  .case-study-hero__btn small {
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .case-study-hero__btn--secondary {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--ml-ink) 38%, transparent);
    color: var(--ml-ink);
  }

  .case-study-hero__btn--secondary:hover,
  .case-study-hero__btn--secondary:focus-visible {
    border-color: var(--ml-ink);
    background: color-mix(in srgb, var(--ml-ink) 4%, transparent);
    transform: translateY(-1px);
  }

  .case-study-hero__artifact {
    margin: 2.75rem 0 0;
    overflow: visible;
    padding: 0;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .case-study-hero__artifact--browser,
  .case-study-hero__artifact--window {
    background: #e9e7e1;
    border: 1px solid rgba(48, 47, 43, 0.22);
    border-radius: 0.55rem;
    box-shadow: 0 0.8rem 2rem rgba(48, 47, 43, 0.08);
    overflow: hidden;
    padding: 0;
  }

  .product-frame__bar {
    align-items: center;
    background: rgba(48, 47, 43, 0.035);
    border-bottom: 1px solid rgba(48, 47, 43, 0.14);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 2rem;
    padding: 0 0.75rem;
  }

  .product-frame__dots {
    display: flex;
    gap: 0.3rem;
  }

  .product-frame__dots i {
    background: rgba(48, 47, 43, 0.28);
    border-radius: 50%;
    display: block;
    height: 0.38rem;
    width: 0.38rem;
  }

  .case-study-hero__artifact--window .product-frame__dots i:first-child {
    background: rgba(143, 74, 54, 0.58);
  }

  .product-frame__label {
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .case-study-hero__artifact-media,
  .case-study-hero__artifact picture {
    display: block;
  }

  .case-study-hero__artifact img {
    display: block;
    width: 100%;
    border-radius: 0.55rem;
    box-shadow:
      0 1.35rem 3.25rem rgba(18, 18, 16, 0.12),
      0 0.4rem 1.1rem rgba(18, 18, 16, 0.06);
  }

  .case-study-hero__artifact--browser img,
  .case-study-hero__artifact--window img {
    border-radius: 0;
    box-shadow: none;
  }

  @media (min-width: 860px) {
    .case-study-hero__overview {
      grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.75fr);
    }

    .case-study-hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.35rem;
    }

    .case-study-hero__fact:nth-child(odd) {
      padding-right: 0.35rem;
    }

    .case-study-hero__fact:nth-child(even) {
      padding-left: 0.35rem;
    }

    .case-study-hero__fact:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .case-study-hero {
      padding-bottom: 1.5rem;
    }

    .case-study-hero__btn {
      width: 100%;
    }
  }
</style>

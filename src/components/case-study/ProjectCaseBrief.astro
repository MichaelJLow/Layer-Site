---
import BrowserShotCarousel from './BrowserShotCarousel.astro';

interface ColumnList {
  title: string;
  items: string[];
}

interface SystemPanel {
  title: string;
  items: string[];
}

interface Challenge {
  title: string;
  body: string;
  tradeoff?: string;
}

interface Shot {
  image: string;
  alt: string;
  label?: string;
  note?: string;
  /** Optional highlight region; click expands that area in a lightbox. */
  focus?: {
    x: number;
    y: number;
    w: number;
    h: number;
  };
}

interface Screenshot {
  src?: string;
  alt?: string;
  caption?: string;
  frame?: 'browser' | 'window';
  frameLabel?: string;
  /** When provided, replaces the static shot with a browser-framed carousel. */
  shots?: Shot[];
  idPrefix?: string;
}

interface BriefSection {
  title: string;
  lead: string;
  items?: string[];
  note?: string;
  body?: string;
  scenario?: string;
  scenarioLabel?: string;
  /** Evaluation: brief harness explainer aside */
  framework?: {
    label?: string;
    body: string;
  };
  /** Problem: two compact columns */
  columns?: ColumnList[];
  /** Solution: pipeline steps */
  pipeline?: string[];
  /** Solution: Hermes vs App split */
  systems?: SystemPanel[];
  /** Solution: briefing section chips */
  sections?: string[];
  sectionsHeading?: string;
  /** Build: numbered challenge cards */
  challenges?: Challenge[];
  /** Results: applied-AI pullquote */
  pullquote?: string;
  /** Results: if extended */
  next?: string[];
  /** Optional closing product screenshot for a section. */
  shot?: Screenshot;
  cta?: {
    label: string;
    href: string;
    note?: string;
    title?: string;
  };
}

interface Props {
  problem: BriefSection;
  solution: BriefSection;
  build: BriefSection;
  evaluation?: BriefSection;
  results: BriefSection;
  screenshot?: Screenshot;
}

const { problem, solution, build, evaluation, results, screenshot } = Astro.props;

const navItems = [
  { id: 'brief-problem', index: '01', shortLabel: 'Problem', fullLabel: problem.title },
  { id: 'brief-solution', index: '02', shortLabel: 'Solution', fullLabel: solution.title },
  { id: 'brief-build', index: '03', shortLabel: 'Build', fullLabel: build.title },
  ...(evaluation
    ? [{ id: 'brief-evaluation', index: '04', shortLabel: 'Evaluation', fullLabel: evaluation.title }]
    : []),
  {
    id: 'brief-results',
    index: evaluation ? '05' : '04',
    shortLabel: 'Results',
    fullLabel: results.title,
  },
];
---

<div class="project-brief">
  <nav class="project-brief__nav" aria-label="Case study sections">
    <ul role="list" style={`--brief-nav-columns: ${navItems.length}`}>
      {
        navItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-brief-nav
              aria-label={`${item.index} ${item.fullLabel}`}
              title={item.fullLabel}
            >
              <span class="project-brief__nav-index" aria-hidden="true">{item.index}</span>
              <span class="project-brief__nav-label">{item.shortLabel}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- 01 Problem -->
  <section
    id="brief-problem"
    class="project-brief__section project-brief__section--problem"
    aria-labelledby="brief-problem-title"
  >
    <header class="project-brief__head">
      <p class="project-brief__index"><span aria-hidden="true">01</span> {problem.title}</p>
      <h2 id="brief-problem-title">{problem.lead}</h2>
    </header>

    {problem.scenario && (
      <aside class="project-brief__scenario">
        <p class="project-brief__scenario-label">{problem.scenarioLabel ?? 'A typical request'}</p>
        <p>{problem.scenario}</p>
      </aside>
    )}

    {problem.body && <p class="project-brief__body">{problem.body}</p>}

    {
      problem.columns && problem.columns.length > 0 ? (
        <div class="project-brief__columns">
          {problem.columns.map((column) => (
            <div class="project-brief__column">
              <p class="project-brief__column-title">{column.title}</p>
              <ul class="project-brief__list" role="list">
                {column.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        problem.items &&
        problem.items.length > 0 && (
          <ul class="project-brief__list" role="list">
            {problem.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      )
    }

    {problem.note && <p class="project-brief__note">{problem.note}</p>}
  </section>

  <!-- 02 Solution -->
  <div class="project-brief__band">
  <section
    id="brief-solution"
    class="project-brief__section project-brief__section--solution"
    aria-labelledby="brief-solution-title"
  >
    <header class="project-brief__head">
      <p class="project-brief__index"><span aria-hidden="true">02</span> {solution.title}</p>
      <h2 id="brief-solution-title">{solution.lead}</h2>
    </header>

    {solution.body && <p class="project-brief__body">{solution.body}</p>}

    {
      solution.pipeline && solution.pipeline.length > 0 && (
        <ol class="project-brief__pipeline" aria-label="System pipeline">
          {solution.pipeline.map((step, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      )
    }

    {
      solution.systems && solution.systems.length > 0 && (
        <div class="project-brief__systems">
          {solution.systems.map((system) => (
            <div class="project-brief__system">
              <p class="project-brief__column-title">{system.title}</p>
              <ul class="project-brief__list" role="list">
                {system.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }

    {
      solution.sections && solution.sections.length > 0 && (
        <div class="project-brief__paths-wrap">
          {solution.sectionsHeading && <p class="project-brief__column-title">{solution.sectionsHeading}</p>}
          <div class="project-brief__paths" aria-label="Example request paths">
            {solution.sections.map((section) => {
              const [issue, outcome] = section.split(' · ');
              return (
                <div class="project-brief__path">
                  <p class="project-brief__path-issue">{issue ?? section}</p>
                  {outcome && <p class="project-brief__path-outcome">{outcome}</p>}
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    {
      solution.items &&
      solution.items.length > 0 &&
      !solution.pipeline &&
      !solution.systems && (
        <ul class="project-brief__list" role="list">
          {solution.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      (solution.note || (screenshot?.shots && screenshot.shots.length > 0) || screenshot?.src) && (
        <div class="project-brief__walkthrough project-brief__walkthrough--feature">
          {solution.note && <p class="project-brief__walkthrough-intro">{solution.note}</p>}

          {
            screenshot?.src && (
              <figure
                class={`project-brief__shot project-brief__shot--lead${screenshot.frame ? ` project-brief__shot--${screenshot.frame}` : ''}`}
              >
                {screenshot.frame && (
                  <div class="product-frame__bar" aria-hidden="true">
                    <span class="product-frame__dots"><i></i><i></i><i></i></span>
                    <span class="product-frame__label">{screenshot.frameLabel ?? screenshot.alt}</span>
                    <span></span>
                  </div>
                )}
                <img src={screenshot.src} alt={screenshot.alt ?? ''} loading="lazy" decoding="async" />
                {screenshot.caption && <figcaption>{screenshot.caption}</figcaption>}
              </figure>
            )
          }

          {
            screenshot?.shots && screenshot.shots.length > 0 && (
              <BrowserShotCarousel
                feature
                frameLabel={screenshot.frameLabel ?? 'libertrade.app'}
                idPrefix={screenshot.idPrefix ?? 'workflow-frame'}
                shots={screenshot.shots}
              />
            )
          }
        </div>
      )
    }
  </section>
  </div>

  <!-- Build -->
  <section
    id="brief-build"
    class="project-brief__section project-brief__section--build"
    aria-labelledby="brief-build-title"
  >
    <header class="project-brief__head">
      <p class="project-brief__index"><span aria-hidden="true">03</span> {build.title}</p>
      <h2 id="brief-build-title">{build.lead}</h2>
    </header>

    {
      build.challenges && build.challenges.length > 0 ? (
        <div class="project-brief__challenges">
          {build.challenges.map((challenge, index) => (
            <article class="project-brief__challenge">
              <p class="project-brief__challenge-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3>{challenge.title}</h3>
              <p>{challenge.body}</p>
              {challenge.tradeoff && <p class="project-brief__tradeoff">{challenge.tradeoff}</p>}
            </article>
          ))}
        </div>
      ) : (
        build.items &&
        build.items.length > 0 && (
          <ul class="project-brief__list" role="list">
            {build.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      )
    }

    {build.note && <p class="project-brief__note">{build.note}</p>}
  </section>

  <!-- Evaluation -->
  {
    evaluation && (
      <div class="project-brief__band">
      <section
        id="brief-evaluation"
        class="project-brief__section project-brief__section--evaluation"
        aria-labelledby="brief-evaluation-title"
      >
        <header class="project-brief__head">
          <p class="project-brief__index">
            <span aria-hidden="true">04</span> {evaluation.title}
          </p>
          <h2 id="brief-evaluation-title">{evaluation.lead}</h2>
        </header>

        {evaluation.body && <p class="project-brief__body">{evaluation.body}</p>}

        {evaluation.scenario && (
          <aside class="project-brief__scenario">
            <p class="project-brief__scenario-label">{evaluation.scenarioLabel ?? 'Why this matters'}</p>
            <p>{evaluation.scenario}</p>
          </aside>
        )}

        {evaluation.framework && (
          <div class="project-brief__framework">
            <p class="project-brief__column-title">{evaluation.framework.label ?? 'Evaluation procedure'}</p>
            <p class="project-brief__body">{evaluation.framework.body}</p>
          </div>
        )}

        {
          evaluation.columns && evaluation.columns.length > 0 ? (
            <div class="project-brief__columns">
              {evaluation.columns.map((column) => (
                <div class="project-brief__column">
                  <p class="project-brief__column-title">{column.title}</p>
                  <ul class="project-brief__list" role="list">
                    {column.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ) : (
            evaluation.items &&
            evaluation.items.length > 0 && (
              <ul class="project-brief__list" role="list">
                {evaluation.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )
          )
        }

        {evaluation.pullquote && (
          <blockquote class="project-brief__pullquote">{evaluation.pullquote}</blockquote>
        )}

        {evaluation.note && <p class="project-brief__note">{evaluation.note}</p>}

        {
          evaluation.shot?.src && (
            <figure
              class={`project-brief__shot${evaluation.shot.frame ? ` project-brief__shot--${evaluation.shot.frame}` : ''}`}
            >
              {evaluation.shot.frame && (
                <div class="product-frame__bar" aria-hidden="true">
                  <span class="product-frame__dots"><i></i><i></i><i></i></span>
                  <span class="product-frame__label">{evaluation.shot.frameLabel ?? evaluation.shot.alt}</span>
                  <span></span>
                </div>
              )}
              <img src={evaluation.shot.src} alt={evaluation.shot.alt ?? ''} loading="lazy" decoding="async" />
              {evaluation.shot.caption && <figcaption>{evaluation.shot.caption}</figcaption>}
            </figure>
          )
        }
      </section>
      </div>
    )
  }

  <!-- Results -->
  <section
    id="brief-results"
    class="project-brief__section project-brief__section--results"
    aria-labelledby="brief-results-title"
  >
    <header class="project-brief__head">
      <p class="project-brief__index">
        <span aria-hidden="true">{evaluation ? '05' : '04'}</span> {results.title}
      </p>
      <h2 id="brief-results-title">{results.lead}</h2>
    </header>

    {
      results.items && results.items.length > 0 && (
        <ul class="project-brief__list" role="list">
          {results.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {results.pullquote && <blockquote class="project-brief__pullquote">{results.pullquote}</blockquote>}

    {
      results.next && results.next.length > 0 && (
        <div class="project-brief__next">
          <p class="project-brief__column-title">If extended</p>
          <ul class="project-brief__list" role="list">
            {results.next.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }

    {results.note && <p class="project-brief__note">{results.note}</p>}

    {
      results.shot?.src && (
        <figure
          class={`project-brief__shot${results.shot.frame ? ` project-brief__shot--${results.shot.frame}` : ''}`}
        >
          {results.shot.frame && (
            <div class="product-frame__bar" aria-hidden="true">
              <span class="product-frame__dots"><i></i><i></i><i></i></span>
              <span class="product-frame__label">{results.shot.frameLabel ?? results.shot.alt}</span>
              <span></span>
            </div>
          )}
          <img src={results.shot.src} alt={results.shot.alt ?? ''} loading="lazy" decoding="async" />
          {results.shot.caption && <figcaption>{results.shot.caption}</figcaption>}
        </figure>
      )
    }
  </section>
</div>

{
  results.cta && (
    <aside class="project-brief__cta-band" aria-labelledby="case-study-review-title">
      <div class="project-brief__cta">
        <div class="project-brief__cta-copy">
          <p class="project-brief__cta-eyebrow">Your first step</p>
          <h2 id="case-study-review-title" class="project-brief__cta-title">
            {results.cta.title ?? 'Start with an AI Opportunity Session'}
          </h2>
        </div>
        <div class="project-brief__cta-side">
          {results.cta.note && <p class="project-brief__cta-note">{results.cta.note}</p>}
          <a class="project-brief__cta-action" href={results.cta.href}>
            {results.cta.label} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </aside>
  )
}

<style>
  .project-brief {
    display: grid;
    gap: 0;
    margin-inline: auto;
    max-width: 100%;
    min-width: 0;
    width: min(100%, 72rem);
  }

  .project-brief__nav {
    display: none;
  }

  .project-brief__nav ul {
    display: grid;
    grid-template-columns: repeat(var(--brief-nav-columns, 5), minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--ml-line);
    border-radius: 0.4rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--ml-paper-raised) 72%, transparent);
  }

  .project-brief__nav li {
    min-width: 0;
  }

  .project-brief__nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 3.35rem;
    padding: 0.7rem 0.45rem;
    border-right: 1px solid var(--ml-line);
    color: var(--ml-muted);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .project-brief__nav li:last-child a {
    border-right: 0;
  }

  .project-brief__nav-index {
    color: color-mix(in srgb, var(--ml-muted) 88%, transparent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-brief__nav-label {
    display: block;
    max-width: 9rem;
    text-wrap: balance;
  }

  .project-brief__nav a:hover,
  .project-brief__nav a:focus-visible {
    background: color-mix(in srgb, var(--ml-paper-raised) 92%, var(--ml-paper-deep));
    color: var(--ml-ink);
  }

  .project-brief__nav a.is-active {
    background: var(--ml-paper-raised);
    box-shadow: inset 0 -2px 0 var(--ml-ink);
    color: var(--ml-ink);
  }

  .project-brief__nav a.is-active .project-brief__nav-index {
    color: var(--ml-clay);
  }

  .project-brief__band {
    background: var(--ml-paper-deep, #eeece5);
    border-block: 1px solid var(--ml-line);
    margin-inline: calc(50% - 50vw);
    padding-inline: max(1.25rem, calc((100vw - min(92rem, 100% - 3rem)) / 2));
    width: 100vw;
  }

  .project-brief__band .project-brief__section {
    border-top: 0;
    padding-block: clamp(2.75rem, 5.5vw, 4.25rem);
  }

  .project-brief__section {
    padding-block: clamp(2.75rem, 5.5vw, 4.25rem);
    border-top: 1px solid var(--ml-line);
    scroll-margin-top: 5.5rem;
  }

  .project-brief__section:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .project-brief__head {
    margin-bottom: 1.5rem;
    max-width: 46rem;
  }

  .project-brief__index {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: color-mix(in srgb, var(--ml-muted) 88%, transparent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-brief__index span {
    color: var(--ml-clay);
  }

  .project-brief__section h2 {
    margin: 0.85rem 0 0;
    color: var(--ml-ink);
    font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .project-brief__body {
    margin: 0 0 1.35rem;
    max-width: 46rem;
    color: var(--ml-ink-soft, var(--ml-muted));
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    font-weight: 400;
    line-height: 1.68;
  }

  .project-brief__scenario {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
    margin: 0 0 1.75rem;
    padding: clamp(1.35rem, 2.5vw, 1.75rem) clamp(1.35rem, 2.5vw, 1.85rem);
    background: color-mix(in srgb, var(--ml-paper-raised) 88%, var(--ml-paper-deep));
    border: 1px solid var(--ml-line);
    border-left: 3px solid var(--ml-ink);
    box-shadow: 0 12px 28px rgba(18, 18, 16, 0.04);
  }

  .project-brief__scenario-label {
    margin: 0;
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-brief__scenario > p:last-child {
    margin: 0;
    color: var(--ml-ink-soft, var(--ml-muted));
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    font-weight: 400;
    line-height: 1.68;
  }

  .project-brief__framework {
    margin: 0 0 1.75rem;
    max-width: 46rem;
  }

  .project-brief__framework .project-brief__body {
    margin-bottom: 0;
  }

  .project-brief__list {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--ml-line-strong, var(--ml-line));
    padding-left: 1rem;
  }

  .project-brief__list li {
    color: var(--ml-ink-soft, var(--ml-muted));
    font-size: clamp(0.96rem, 1.12vw, 1.04rem);
    font-weight: 400;
    line-height: 1.58;
  }

  .project-brief__note {
    margin: 1.35rem 0 0;
    max-width: 42rem;
    color: var(--ml-muted);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.62;
  }

  .project-brief__section--solution .project-brief__body {
    margin-bottom: 1.75rem;
  }

  .project-brief__section--solution .project-brief__systems {
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .project-brief__paths-wrap {
    margin: 0 0 clamp(2.25rem, 4vw, 3rem);
  }

  .project-brief__paths-wrap .project-brief__column-title {
    margin-bottom: 1rem;
  }

  .project-brief__paths {
    border: 1px solid var(--ml-line);
    display: grid;
    gap: 0;
  }

  .project-brief__path {
    display: grid;
    gap: 0.35rem;
    padding: 1.15rem 1.2rem;
    border-bottom: 1px solid var(--ml-line);
  }

  .project-brief__path:last-child {
    border-bottom: 0;
  }

  .project-brief__path-issue {
    margin: 0;
    color: var(--ml-ink);
    font-size: 0.98rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .project-brief__path-outcome {
    margin: 0;
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .project-brief__walkthrough {
    display: grid;
    gap: 1.15rem;
    margin-top: 0.5rem;
  }

  .project-brief__walkthrough--feature {
    gap: 1.35rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .project-brief__walkthrough-intro {
    margin: 0;
    max-width: 42rem;
    color: var(--ml-ink-soft);
    font-size: clamp(0.98rem, 1.15vw, 1.05rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.62;
    text-transform: none;
  }

  /* Problem columns */
  .project-brief__columns,
  .project-brief__systems {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: 0.35rem;
  }

  .project-brief__column-title {
    margin: 0 0 0.85rem;
    color: var(--ml-muted);
